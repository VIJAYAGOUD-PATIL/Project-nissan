        def enter(e, c=card, b=btn, col=color):
            c.config(highlightbackground=col)
        def leave(e, c=card, b=btn):
            c.config(highlightbackground=BORDER)

        for w in (card, body, strip, btn):
            w.bind("<Enter>", enter)
            w.bind("<Leave>", leave)

    def _open_project(self, project):
        self.root.destroy()
        r = tk.Tk()
        DefectDashboard(r, project)
        r.mainloop()

    def _logout(self):
        if messagebox.askyesno("Logout", "Are you sure you want to logout?"):
            self.root.destroy()
            r = tk.Tk()
            LoginWindow(r)
            r.mainloop()


