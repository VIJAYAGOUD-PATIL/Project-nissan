                        padx=22, pady=11, command=do_create)
        sub.pack(side="left")
        sub.bind("<Enter>", lambda e: sub.config(bg=BRAND_DARK))
        sub.bind("<Leave>", lambda e: sub.config(bg=self._color))

        tk.Button(btn_row, text="Cancel",
                  bg="#f0f2f5", fg=TEXT_SEC,
                  font=("Segoe UI", 11), relief="flat", cursor="hand2",
                  padx=18, pady=11,
                  command=dlg.destroy).pack(side="left", padx=12)

