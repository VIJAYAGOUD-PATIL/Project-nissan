# ── Calendar Picker ────────────────────────────────────────────────────────────
class _CalendarPicker(tk.Toplevel):
    """Lightweight calendar popup — sets a StringVar to YYYY-MM-DD."""
    def __init__(self, parent, var: tk.StringVar):
        super().__init__(parent)
        self.var = var
        self.title("Select Date")
        self.resizable(False, False)
        self.grab_set()
        self.configure(bg=SURFACE)

        # Parse current value or default to today
        today = datetime.date.today()
        try:
            d = datetime.date.fromisoformat(var.get())
        except Exception:
            d = today
        self._year  = d.year
        self._month = d.month

        self._build()
        # Centre over parent
        self.update_idletasks()
        px = parent.winfo_rootx() + parent.winfo_width()  // 2 - self.winfo_width()  // 2
        py = parent.winfo_rooty() + parent.winfo_height() // 2 - self.winfo_height() // 2
        self.geometry(f"+{px}+{py}")

    def _build(self):
        # Clear existing children
        for w in self.winfo_children():
            w.destroy()

        DAYS  = ["Mo","Tu","We","Th","Fr","Sa","Su"]
        hdr   = tk.Frame(self, bg=BRAND)
        hdr.pack(fill="x")

        tk.Button(hdr, text="‹", bg=BRAND, fg="white",
            font=("Segoe UI", 12, "bold"), relief="flat",
            cursor="hand2", padx=10, pady=4,
            command=self._prev_month
        ).pack(side="left")

        month_name = datetime.date(self._year, self._month, 1).strftime("%B %Y")
        tk.Label(hdr, text=month_name, bg=BRAND, fg="white",
            font=("Segoe UI", 11, "bold")
        ).pack(side="left", expand=True)

        tk.Button(hdr, text="›", bg=BRAND, fg="white",
            font=("Segoe UI", 12, "bold"), relief="flat",
            cursor="hand2", padx=10, pady=4,
            command=self._next_month
        ).pack(side="right")

        # Day headers
        body = tk.Frame(self, bg=SURFACE, padx=6, pady=4)
        body.pack()
        for i, d in enumerate(DAYS):
            fg = BRAND if d in ("Sa","Su") else TEXT_MUTED
            tk.Label(body, text=d, width=3, bg=SURFACE, fg=fg,
                font=("Segoe UI", 8, "bold")
            ).grid(row=0, column=i, padx=1, pady=(0,2))

        import calendar
        cal = calendar.monthcalendar(self._year, self._month)
        today = datetime.date.today()
        for r, week in enumerate(cal, start=1):
            for c, day in enumerate(week):
                if day == 0:
                    tk.Label(body, text="", width=3, bg=SURFACE).grid(row=r, column=c)
                else:
                    is_today = (day == today.day and
                                self._month == today.month and
                                self._year  == today.year)
                    btn_bg = BRAND      if is_today else SURFACE
                    btn_fg = "white"    if is_today else TEXT_PRI
                    btn = tk.Button(body, text=str(day), width=3,
                        bg=btn_bg, fg=btn_fg,
                        font=("Segoe UI", 9), relief="flat",
                        cursor="hand2", pady=3,
                        activebackground=BRAND_DARK, activeforeground="white",
                        command=lambda d=day: self._pick(d))
                    btn.grid(row=r, column=c, padx=1, pady=1)

        # Today / Clear buttons
        footer = tk.Frame(self, bg="#f5f5f5",
            highlightbackground=BORDER, highlightthickness=1)
        footer.pack(fill="x")
        tk.Button(footer, text="Today", bg=SURFACE, fg=BRAND,
            font=("Segoe UI", 9, "bold"), relief="flat",
            cursor="hand2", padx=10, pady=4,
            command=lambda: self._pick_date(today)
        ).pack(side="left", padx=6, pady=4)
        tk.Button(footer, text="Clear", bg=SURFACE, fg=TEXT_SEC,
            font=("Segoe UI", 9), relief="flat",
            cursor="hand2", padx=10, pady=4,
            command=self._clear
        ).pack(side="right", padx=6, pady=4)

    def _prev_month(self):
        if self._month == 1:
            self._month, self._year = 12, self._year - 1
        else:
            self._month -= 1
        self._build()

    def _next_month(self):
        if self._month == 12:
            self._month, self._year = 1, self._year + 1
        else:
            self._month += 1
        self._build()

    def _pick(self, day):
        self._pick_date(datetime.date(self._year, self._month, day))

    def _pick_date(self, d):
        self.var.set(d.isoformat())
        self.destroy()

    def _clear(self):
        self.var.set("")
        self.destroy()


