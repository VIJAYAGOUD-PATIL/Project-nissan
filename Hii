# ── Persistence ────────────────────────────────────────────────────────────────
def load_defects():
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return []

def save_defects(arr):
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(arr, f, indent=2, ensure_ascii=False)

# ── Scrollable Frame ───────────────────────────────────────────────────────────
class ScrollableFrame(tk.Frame):
    def __init__(self, parent, bg=BG, **kw):
        super().__init__(parent, bg=bg, **kw)
        self._canvas  = tk.Canvas(self, bg=bg, highlightthickness=0)
        self._vsb     = ttk.Scrollbar(self, orient="vertical",
                                      command=self._canvas.yview)
        self.inner    = tk.Frame(self._canvas, bg=bg)
        self._win_id  = self._canvas.create_window(
            (0, 0), window=self.inner, anchor="nw")
        self._canvas.configure(yscrollcommand=self._vsb.set)
        self._canvas.pack(side="left", fill="both", expand=True)
        self._vsb.pack(side="right", fill="y")

        self.inner.bind("<Configure>",
            lambda e: self._canvas.configure(
                scrollregion=self._canvas.bbox("all")))
        self._canvas.bind("<Configure>",
            lambda e: self._canvas.itemconfig(
                self._win_id, width=e.width))
        # Mouse wheel
        for widget in (self._canvas, self.inner):
            widget.bind("<MouseWheel>",
                lambda e: self._canvas.yview_scroll(
                    -1 * (e.delta // 120), "units"))
            widget.bind("<Button-4>",
                lambda e: self._canvas.yview_scroll(-1, "units"))
            widget.bind("<Button-5>",
                lambda e: self._canvas.yview_scroll(1, "units"))


# ── Codebeamer Progress Popup ──────────────────────────────────────────────────
class _CBProgressWindow(tk.Toplevel):
    """Live step-by-step progress popup for Codebeamer automation."""
    def __init__(self, parent):
        super().__init__(parent)
        self.title("Codebeamer — Submitting Defect")
        self.geometry("480x380")
        self.resizable(False, False)
        self.configure(bg=SURFACE)
        self.grab_set()

        # Header
        hdr = tk.Frame(self, bg=BRAND, height=6)
        hdr.pack(fill="x")

        tk.Label(self, text="🔄  Submitting to Codebeamer",
            bg=SURFACE, fg=TEXT_PRI,
            font=("Segoe UI", 13, "bold")
        ).pack(pady=(18, 4))

        self._status_lbl = tk.Label(self, text="Initialising…",
            bg=SURFACE, fg=TEXT_SEC,
            font=("Segoe UI", 10))
        self._status_lbl.pack()

        # Progress bar
        pb_frame = tk.Frame(self, bg=SURFACE)
        pb_frame.pack(fill="x", padx=30, pady=(10, 0))
        self._pb = ttk.Progressbar(pb_frame, mode="determinate",
            maximum=100, value=0)
        self._pb.pack(fill="x")

        # Log area
        log_frame = tk.Frame(self, bg="#f9fafb",
            highlightbackground=BORDER, highlightthickness=1)
        log_frame.pack(fill="both", expand=True, padx=20, pady=12)
        self._log = tk.Text(log_frame, bg="#f9fafb", fg=TEXT_SEC,
            font=("Consolas", 9), relief="flat",
            state="disabled", wrap="word",
            padx=8, pady=8)
        self._log.pack(fill="both", expand=True)

        self._close_btn = tk.Button(self, text="Close",
            bg="#e5e7eb", fg=TEXT_SEC,
            font=("Segoe UI", 10), relief="flat",
            padx=20, pady=6, cursor="hand2",
            state="disabled",
            command=self.destroy)
        self._close_btn.pack(pady=(0, 14))

    def log(self, msg: str, color: str = TEXT_SEC):
        """Append a line to the log (thread-safe via after)."""
        def _do():
            self._log.config(state="normal")
            self._log.insert("end", msg + "\n")
            self._log.see("end")
            self._log.config(state="disabled")
            self._status_lbl.config(text=msg)
        self.after(0, _do)

    def set_progress(self, pct: int):
        def _do():
            self._pb["value"] = pct
        self.after(0, _do)

    def finish(self, success: bool):
        def _do():
            if success:
                self._status_lbl.config(text="✅  All fields submitted successfully!", fg=GREEN)
                self._pb["value"] = 100
            else:
                self._status_lbl.config(text="❌  Automation stopped — check log above.", fg=RED)
            self._close_btn.config(state="normal", bg=BRAND, fg="white")
        self.after(0, _do)


# ── Codebeamer Playwright automation ──────────────────────────────────────────
#
#  SELECTOR GUIDE — how to find a field's CB ID:
#  ───────────────────────────────────────────────
#  Open your CB create page → right-click any field → Inspect Element
#
#  TEXT INPUT   →  <input  name="XXXX">   use:  input[name="XXXX"]
#  DROPDOWN     →  <select name="XXXX">   use:  select[name="XXXX"]
#  TEXTAREA     →  <textarea name="XXXX"> use:  textarea[name="XXXX"]
#  CB CHOOSER   →  <table title="Choose XXXX">  use that title string exactly
#
#  Every field below has a  # ← CB: change "XXXX" to real name/id  comment.
#  If a field is empty when you submit, it is automatically skipped.
# ─────────────────────────────────────────────────────────────────────────────

def login_codebeamer(rec: dict, progress_win=None):

    if not _PLAYWRIGHT_OK:
        if progress_win:
            progress_win.log("❌  Playwright not installed.\n    Run: pip install playwright && playwright install chromium")
            progress_win.finish(False)
        return

    # ── tiny helpers ──────────────────────────────────────────────────────────
    def _log(msg):
        print(msg)
        if progress_win:
            progress_win.log(msg)

    def _prog(pct):
        if progress_win:
            progress_win.set_progress(pct)

    def _find_field(label_text):
        """Find the input/select/textarea whose label matches label_text."""
        lt = label_text.strip().lower()
        try:
            for lbl in page.locator("label").all():
                try:
                    txt = (lbl.inner_text() or "").strip().lower()
                    if lt in txt or txt in lt:
                        for_id = lbl.get_attribute("for")
                        if for_id:
                            el = page.locator(f"#{for_id}")
                            if el.count() > 0:
                                return el.first
                        parent = lbl.locator("xpath=..")
                        for tag in ("input", "select", "textarea"):
                            sib = parent.locator(tag)
                            if sib.count() > 0:
                                return sib.first
                except Exception:
                    continue
            el = page.get_by_label(label_text, exact=False)
            if el.count() > 0:
                return el.first
            for tag in ("input", "select", "textarea"):
                el = page.locator(
                    f'{tag}[placeholder*="{label_text}" i], '
                    f'{tag}[title*="{label_text}" i], '
                    f'{tag}[aria-label*="{label_text}" i]'
                )
                if el.count() > 0:
                    return el.first
        except Exception:
            pass
        return None

    def _fill_by_label(label, value, field_type="auto"):
        """Find a field by its label text and fill it."""
        if not str(value).strip() or str(value).strip() in ("--", ""):
            _log(f"   \u23ed  {label} \u2014 skipped (empty)"); return
        el = _find_field(label)
        if el is None:
            _log(f"   \u26a0\ufe0f  {label} \u2014 field not found on page"); return
        try:
            tag = el.evaluate("e => e.tagName.toLowerCase()") if field_type == "auto" else field_type
            val_str = str(value).strip()
            if tag == "select" or field_type == "select":
                try:
                    el.select_option(label=val_str)
                except Exception:
                    el.select_option(value=val_str)
            else:
                el.fill(val_str)
            _log(f"   \u2705  {label}: {value}")
        except Exception as ex:
            _log(f"   \u26a0\ufe0f  {label}: {ex}")

    def _chooser_by_label(label, value):
        """Codebeamer chooser: find by label, type into textbox, press Enter."""
        if not str(value).strip():
            _log(f"   \u23ed  {label} \u2014 skipped (empty)"); return
        val_str = str(value).strip()
        lt = label.strip().lower()
        try:
            for lbl in page.locator("label").all():
                try:
                    txt = (lbl.inner_text() or "").strip().lower()
                    if lt in txt or txt in lt:
                        parent = lbl.locator("xpath=..")
                        inp = parent.locator('input[type="text"], input:not([type])').first
                        if inp.count() > 0:
                            inp.click()
                            inp.press_sequentially(val_str, delay=120)
                            page.wait_for_timeout(500)
                            page.keyboard.press("Enter")
                            _log(f"   \u2705  {label}: {value}"); return
                except Exception:
                    continue
            tbl = page.locator(f'table[title*="Choose {label}"]').first
            if tbl.count() > 0:
                inp = tbl.get_by_role("textbox")
                inp.click()
                inp.press_sequentially(val_str, delay=120)
                page.wait_for_timeout(500)
                page.keyboard.press("Enter")
                _log(f"   \u2705  {label}: {value}"); return
            _log(f"   \u26a0\ufe0f  {label} \u2014 chooser not found on page")
        except Exception as ex:
            _log(f"   \u26a0\ufe0f  {label}: {ex}")

    def _text(label, selector, value):
        _fill_by_label(label, value, "auto")

    def _combo(label, selector, value):
        _fill_by_label(label, value, "select")

    def _chooser(label, table_title, value):
        _chooser_by_label(label, value)

    def _area(label, selector, value):
        _fill_by_label(label, value, "textarea")

    # ── main thread ───────────────────────────────────────────────────────────
    def _run():
        try:
            with sync_playwright() as p:
                browser = p.chromium.launch(headless=False, slow_mo=100)
                nonlocal page
                page = browser.new_page()
                page.set_default_timeout(5000)  # fail fast on wrong selectors

                # ── LOGIN ──────────────────────────────────────────────────────
                cb_url = os.getenv("CB_URL", "")
                if not cb_url:
                    _log("❌  CB_URL not set in .env"); progress_win.finish(False); return

                _log(f"🌐  Opening login: {cb_url}"); _prog(5)
                page.goto(cb_url)

                _log("🔐  Logging in…"); _prog(8)
                # ↓ CB: change "user" / "password" to match your login form's input names
                page.locator('input[name="user"]').fill(os.getenv("username", ""))
                page.locator('input[name="password"]').fill(os.getenv("passwords", ""))
                page.locator('input[type="submit"]').click()
                page.wait_for_load_state("networkidle", timeout=20000)
                _log("✅  Logged in"); _prog(15)

                # ── NAVIGATE TO CREATE PAGE ────────────────────────────────────
