        self._dash_tree.grid(row=2, column=0, sticky="nsew", padx=1, pady=1)
        vsb.grid(row=2, column=1, sticky="ns")
        self._apply_tree_tags(self._dash_tree)

    def _refresh_dashboard(self):
        d = self.defects
        total    = len(d)
        open_    = sum(1 for x in d if x.get("status","").lower() == "open")
        closed   = sum(1 for x in d if x.get("status","").lower() == "closed")
        critical = sum(1 for x in d if x.get("priority","").lower() == "critical")
        self._stat_vals["total"].config(text=str(total))
        self._stat_vals["open"].config(text=str(open_))
        self._stat_vals["closed"].config(text=str(closed))
        self._stat_vals["critical"].config(text=str(critical))

        t = self._dash_tree
        t.delete(*t.get_children())
        for rec in reversed(d[-10:]):
            pri = rec.get("priority", "")
