            r  = srow(defs, dbg, lbl, desc)
            tgl = tk.Label(r, cursor="hand2", font=("Segoe UI", 10, "bold"))
            tgl.pack(side="right")
            def _upd2(t=tgl, v=bv):
                if v.get():
                    t.config(text=" ON ", bg=BRAND, fg="white", padx=4, pady=3)
                else:
                    t.config(text="OFF", bg="#e5e7eb", fg=TEXT_SEC, padx=4, pady=3)
            def _clk2(t=tgl, v=bv, u=_upd2):
                v.set(not v.get()); u()
            tgl.bind("<Button-1>", lambda e, c=_clk2: c())
            _upd2()

        # ── 5. Appearance ────────────────────────────────────────
        app_b, abg = scard("🌐  Appearance", 2, 0)
        for lbl, vals, default in (
            ("Language",      ["English","Hindi","Tamil","Telugu"],     "English"),
            ("Date format",   ["DD MMM YYYY","MM/DD/YYYY","YYYY-MM-DD"],"DD MMM YYYY"),
            ("Items per page",["10","25","50","100"],                   "25"),
        ):
            r = srow(app_b, abg, lbl)
            cb = ttk.Combobox(r, values=vals, state="readonly",
                width=14, font=("Segoe UI", 11))
            cb.set(default)
            cb.pack(side="right")

        # ── 6. Danger Zone ────────────────────────────────────────
        dng, zb = scard("⚠  Danger Zone", 2, 1, danger=True)
        r1 = srow(dng, zb, "Export all defects", "Download as CSV file")
        tk.Button(r1, text="Export CSV",
            bg="white", fg=TEXT_SEC, font=("Segoe UI", 11),
            relief="flat", highlightbackground=BORDER, highlightthickness=1,
            padx=10, pady=5, cursor="hand2",
            command=self._export_csv
        ).pack(side="right")
        r2 = srow(dng, zb, "Delete account", "This action cannot be undone")
        tk.Button(r2, text="Delete",
            bg="white", fg=RED, font=("Segoe UI", 11),
            relief="flat", highlightbackground="#fca5a5", highlightthickness=1,
            padx=10, pady=5, cursor="hand2",
            command=lambda: messagebox.askyesno(
                "Delete Account",
                "Delete your account? This cannot be undone.")
        ).pack(side="right")

    def _save_profile(self):
        name = self._s_name.get().strip()
        if name:
            parts = name.split()
            initials = "".join(p[0].upper() for p in parts[:2]) or "VK"
            self._nav_avatar.config(text=initials)
            self._nav_name_lbl.config(text=name)
        messagebox.showinfo("Settings", "Profile saved successfully!")

    def _change_password(self):
        cur = self._sp_cur.get()
        new = self._sp_new.get()
        cnf = self._sp_cnf.get()
        if not cur:
            messagebox.showerror("Error","Enter your current password."); return
        if len(new) < 8:
            messagebox.showerror("Error","New password must be ≥ 8 characters."); return
        if new != cnf:
            messagebox.showerror("Error","Passwords do not match."); return
        messagebox.showinfo("Success","Password updated successfully!")
        self._sp_cur.set(""); self._sp_new.set(""); self._sp_cnf.set("")

    # ── Shared helpers ─────────────────────────────────────────────
    @staticmethod
    def _apply_tree_tags(tree):
        tree.tag_configure("Critical", foreground=BRAND)
        tree.tag_configure("Major",    foreground=ORANGE)
        tree.tag_configure("Minor",    foreground=GREEN)
        tree.tag_configure("critical", foreground=BRAND)
        tree.tag_configure("major",    foreground=ORANGE)
        tree.tag_configure("minor",    foreground=GREEN)
        tree.tag_configure("open",     foreground=RED)
        tree.tag_configure("closed",   foreground=GREEN)

    def _logout(self):
        if messagebox.askyesno("Logout","Are you sure you want to logout?"):
            self.root.destroy()


