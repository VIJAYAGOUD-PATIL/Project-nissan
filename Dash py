    # CREATE DEFECT
    # ══════════════════════════════════════════════════════════════
    def _build_create(self):
        p = self._pages["create"]
        p.rowconfigure(1, weight=1)
        p.columnconfigure(0, weight=1)

        hdr = tk.Frame(p, bg=BG)
        hdr.grid(row=0, column=0, sticky="ew", padx=28, pady=(24, 10))
        tk.Label(hdr, text="Create Defect", bg=BG, fg=TEXT_PRI,
            font=("Segoe UI", 20, "bold")).pack(side="left")
        tk.Label(hdr, text="Fill in the details below to log a new defect",
            bg=BG, fg=TEXT_MUTED, font=("Segoe UI", 11)
        ).pack(side="left", padx=12)

        scroll = ScrollableFrame(p, bg=BG)
        scroll.grid(row=1, column=0, sticky="nsew", padx=28, pady=(0, 10))
        inner = scroll.inner
        inner.columnconfigure(0, weight=1)

        # ── Grid-form card ────────────────────────────────────────
        card = tk.Frame(inner, bg=SURFACE,
            highlightbackground=BORDER, highlightthickness=1)
        card.pack(fill="x", pady=(0, 12))

        self._cf = {}   # create-fields dict: key → tk.StringVar

        FIELDS = [
            # (label, key, type, placeholder/values, span)
            ("Title *",              "title",               "entry", "Brief description of the defect", 3),
            ("Tracker",              "tracker",             "entry", "Bug / Feature / Task",            1),
            ("Parent",               "parent",              "entry", "e.g. DEF-100",                    1),
            ("Status *",             "status",              "combo",
             ["", "Open","In Progress","Reopen","Resolved","Closed","Critical"],  1),
            ("Priority *",           "priority",            "combo",
             ["", "Critical","Major","Minor"],                                     1),
            ("Test Case ID",         "test_case_id",        "entry", "TC-001",    1),
            ("Assigned To *",        "assigned_to",         "entry", "Name",      1),
            ("Date *",               "date",                "entry", str(datetime.date.today()), 1),
            ("Function",             "function",            "entry", "", 1),
            ("Bug Symptom",          "bug_symptom",         "entry", "", 1),
            ("Submitted By",         "submitted_by",        "entry", "", 1),
            ("Modified By",          "modified_by",         "entry", "", 1),
            ("Watcher",              "watcher",             "entry", "", 1),
            ("Affected Version",     "affected_version",    "entry", "", 1),
            ("Test Environment",     "test_environment",    "entry", "", 1),
            ("HW Version",           "hw_version",          "entry", "", 1),
            ("Resolution",           "resolution",          "entry", "", 1),
            ("Reproducibility",      "reproducibility",     "entry", "", 1),
            ("Occurrence Rate",      "occurrence_rate",     "entry", "", 1),
            ("Severity",             "severity",            "entry", "", 1),
            ("Root Cause Type",      "root_cause_type",     "entry", "", 1),
            ("Test Location",        "test_location",       "entry", "", 1),
            ("NPI",                  "npi",                 "entry", "", 1),
            ("NPI Event Order",      "npi_event_order",     "entry", "", 1),
            ("Root Cause",           "root_cause",          "entry", "", 1),
            ("Countermeasure",       "countermeasure",      "entry", "0", 1),
            ("Commit ID",            "commit_id",           "entry", "", 1),
            ("Fixed Version",        "fixed_version",       "entry", "", 1),
            ("Variant",              "variant",             "entry", "", 1),
            ("Variant Vehicle Info", "variant_vehicle_info","entry", "", 1),
            ("Confirmation Version", "confirmation_version","entry", "", 1),
            ("Holding Reason",       "holding_reason",      "entry", "", 1),
            ("Resolved Date",        "resolved_date",       "entry", "", 1),
            ("Test Field",           "test_field",          "entry", "", 1),
            ("Bug Owner",            "bug_owner",           "entry", "", 1),
            ("Open To OEM",          "open_to_oem",         "entry", "", 1),
            ("Against Who",          "against_who",         "entry", "", 1),
            ("Document Issue",       "document_issue",      "entry", "", 1),
            ("REQ Based",            "req_based",           "entry", "", 1),
            ("Test Strategy",        "test_strategy",       "entry", "", 1),
            ("VLM Key",              "vlm_key",             "entry", "", 1),
            ("VLM Status",           "vlm_status",          "entry", "", 1),
            ("VLM Assignee",         "vlm_assignee",        "entry", "", 1),
            ("VLM Reporter",         "vlm_reporter",        "entry", "", 1),
            ("OEM Key",              "oem_key",             "entry", "", 1),
            ("OEM Status",           "oem_status",          "entry", "", 1),
            ("OEM Assignee",         "oem_assignee",        "entry", "", 1),
            ("OEM Reporter",         "oem_reporter",        "entry", "", 1),
            ("Last Send Time",       "last_send_time",      "entry", "", 1),
            ("Last Send Log",        "last_send_log",       "entry", "", 1),
            ("Due Date",             "due_date",            "entry", "", 1),
            ("Reopen Count",         "reopen_count",        "entry", "", 1),
            ("Labels",               "labels",              "entry", "", 1),
        ]

        NCOLS = 5
        for c in range(NCOLS):
            card.columnconfigure(c, weight=1)

        row_i, col_i = 0, 0
        for lbl_text, key, ftype, opts, span in FIELDS:
            if col_i + span > NCOLS:
                row_i += 1
                col_i = 0
            even = (row_i % 2 == 0)
            cell_bg = SURFACE if even else "#fafbfc"
            cell = tk.Frame(card, bg=cell_bg,
                highlightbackground="#f0f2f5", highlightthickness=1)
            cell.grid(row=row_i, column=col_i, columnspan=span,
                sticky="nsew", ipadx=8, ipady=4)

            tk.Label(cell, text=lbl_text.upper(),
                bg=cell_bg, fg=TEXT_MUTED,
                font=("Segoe UI", 8, "bold"), anchor="w"
            ).pack(fill="x", padx=8, pady=(6, 2))

            var = tk.StringVar()
            if ftype == "entry":
                ent = tk.Entry(cell, textvariable=var,
                    bg=cell_bg, fg=TEXT_PRI,
                    font=("Segoe UI", 11), relief="flat",
                    highlightbackground="#e5e7eb", highlightthickness=1,
                    bd=0, insertbackground=TEXT_PRI)
                ent.pack(fill="x", padx=8, pady=(0, 8))
                # Placeholder behaviour
                if opts and key != "date":
                    ent.insert(0, opts)
                    ent.config(fg=TEXT_MUTED)
                    def _fi(e, w=ent, ph=opts):
                        if w.get() == ph:
                            w.delete(0, "end")
                            w.config(fg=TEXT_PRI)
                    def _fo(e, w=ent, ph=opts):
                        if not w.get():
                            w.insert(0, ph)
                            w.config(fg=TEXT_MUTED)
                    ent.bind("<FocusIn>",  _fi)
                    ent.bind("<FocusOut>", _fo)
                elif key == "date":
                    var.set(opts)
            else:
                cb = ttk.Combobox(cell, textvariable=var,
                    values=opts, font=("Segoe UI", 11), state="readonly")
                cb.pack(fill="x", padx=8, pady=(0, 8))
            self._cf[key] = var
            col_i += span
            if col_i >= NCOLS:
                col_i = 0
                row_i += 1

        # ── Description ───────────────────────────────────────────
        desc_card = tk.Frame(inner, bg=SURFACE,
            highlightbackground=BORDER, highlightthickness=1)
        desc_card.pack(fill="x", pady=(0, 12))
        tk.Label(desc_card, text="DESCRIPTION",
            bg=SURFACE, fg=TEXT_MUTED, font=("Segoe UI", 8, "bold"),
            anchor="w").pack(fill="x", padx=16, pady=(12, 4))

        self._desc = tk.Text(desc_card, height=7,
            bg=SURFACE, fg=TEXT_MUTED,
            font=("Segoe UI", 11), relief="flat",
            highlightbackground=BORDER, highlightthickness=1,
            padx=10, pady=8, wrap="word")
        self._desc.pack(fill="x", padx=12, pady=(0, 12))
        _PH_DESC = "Enter description, steps to reproduce, expected vs actual results…"
        self._desc.insert("1.0", _PH_DESC)

        def _desc_fi(e):
            if self._desc.cget("fg") == TEXT_MUTED:
                self._desc.delete("1.0", "end")
                self._desc.config(fg=TEXT_PRI)
        def _desc_fo(e):
            if not self._desc.get("1.0", "end").strip():
                self._desc.insert("1.0", _PH_DESC)
                self._desc.config(fg=TEXT_MUTED)
        self._desc.bind("<FocusIn>",  _desc_fi)
        self._desc.bind("<FocusOut>", _desc_fo)

        # ── Attachments ───────────────────────────────────────────
        att_card = tk.Frame(inner, bg=SURFACE,
            highlightbackground=BORDER, highlightthickness=1)
        att_card.pack(fill="x", pady=(0, 12))
        tk.Label(att_card, text="📎  ATTACHMENTS",
            bg=SURFACE, fg=TEXT_MUTED, font=("Segoe UI", 8, "bold"),
            anchor="w").pack(fill="x", padx=16, pady=(12, 4))

        dropzone = tk.Frame(att_card, bg="#f8f9fa",
            highlightbackground=BORDER, highlightthickness=1,
            cursor="hand2")
        dropzone.pack(fill="x", padx=12, pady=(0, 6))
        tk.Label(dropzone, text="⬆  Click to select files",
            bg="#f8f9fa", fg=TEXT_MUTED,
            font=("Segoe UI", 11)).pack(pady=(14, 4))
        tk.Label(dropzone, text="PNG, JPG, PDF, ZIP, LOG — max 50 MB each",
            bg="#f8f9fa", fg=TEXT_MUTED,
            font=("Segoe UI", 9)).pack(pady=(0, 12))
        dropzone.bind("<Button-1>", lambda e: self._pick_files())

        self._att_list = tk.Frame(att_card, bg=SURFACE)
        self._att_list.pack(fill="x", padx=12, pady=(0, 10))

        # ── Actions ───────────────────────────────────────────────
        act = tk.Frame(inner, bg=BG)
        act.pack(fill="x", pady=(8, 24))
        tk.Button(act, text="Cancel",
            bg=SURFACE, fg=TEXT_SEC,
            font=("Segoe UI", 11, "bold"), relief="flat",
            highlightbackground=BORDER, highlightthickness=1,
            padx=20, pady=8, cursor="hand2",
            command=lambda: self.show_page("dashboard")
        ).pack(side="left")
        tk.Button(act, text="  ＋  Submit Defect",
            bg=BRAND, fg="white",
