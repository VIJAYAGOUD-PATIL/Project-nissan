    # ── Sidebar ────────────────────────────────────────────────────
    def _build_sidebar(self):
        self._sidebar = tk.Frame(self.root, bg=SIDEBAR_BG, width=230)
        self._sidebar.grid(row=1, column=0, sticky="ns")
        self._sidebar.grid_propagate(False)
        self._nav_btns = {}

        def sec(text):
            tk.Label(self._sidebar, text=text, bg=SIDEBAR_BG, fg="#3d4d63",
                font=("Segoe UI", 8, "bold"), anchor="w",
                padx=22).pack(fill="x", pady=(16, 2))

        def nav(label, page, icon):
            btn = tk.Button(self._sidebar,
                text=f"  {icon}   {label}", anchor="w",
                bg=SIDEBAR_BG, fg="#8a9ab5",
                font=("Segoe UI", 12), relief="flat",
                cursor="hand2", padx=12, pady=9,
                activebackground="#1a2637", activeforeground="white",
                command=lambda p=page: self.show_page(p))
            btn.pack(fill="x", padx=10, pady=1)
            self._nav_btns[page] = btn

        sec("MAIN")
        nav("Dashboard",     "dashboard",  "⊞")
        nav("Create Defect", "create",     "⊕")
        nav("View Defects",  "view",       "☑")
        sec("ANALYTICS")
        nav("Reports",       "reports",    "▦")
        sec("ACCOUNT")
        nav("Settings",      "settings",   "⚙")

        tk.Label(self._sidebar, text="LG © 2026",
            bg=SIDEBAR_BG, fg="#283040",
            font=("Segoe UI", 10)).pack(side="bottom", pady=14)

        self._set_active_nav("dashboard")

    def _set_active_nav(self, page):
        for p, btn in self._nav_btns.items():
            if p == page:
                btn.config(bg="#1e0a12", fg="#ffffff",
                    font=("Segoe UI", 12, "bold"))
            else:
                btn.config(bg=SIDEBAR_BG, fg="#8a9ab5",
                    font=("Segoe UI", 12))

    # ── Main area ──────────────────────────────────────────────────
    def _build_main(self):
        self._main = tk.Frame(self.root, bg=BG)
        self._main.grid(row=1, column=1, sticky="nsew")
        self._main.rowconfigure(0, weight=1)
        self._main.columnconfigure(0, weight=1)
        self._pages: dict[str, tk.Frame] = {}
        for name in ("dashboard", "create", "view", "reports", "settings"):
            f = tk.Frame(self._main, bg=BG)
            f.grid(row=0, column=0, sticky="nsew")
            self._pages[name] = f
        self._build_dashboard()
        self._build_create()
        self._build_view()
        self._build_reports()
        self._build_settings()
        self.show_page("dashboard")

    def show_page(self, name: str):
        self._pages[name].tkraise()
        self._set_active_nav(name)
        if   name == "dashboard": self._refresh_dashboard()
        elif name == "view":      self._refresh_view()
        elif name == "reports":   self._refresh_reports()

    # ══════════════════════════════════════════════════════════════
    # DASHBOARD
    # ══════════════════════════════════════════════════════════════
    def _build_dashboard(self):
        p = self._pages["dashboard"]
        p.columnconfigure(0, weight=1)
        p.rowconfigure(3, weight=1)

        # Header
        hdr = tk.Frame(p, bg=BG)
        hdr.grid(row=0, column=0, sticky="ew", padx=28, pady=(24, 0))
        tk.Label(hdr, text="Dashboard", bg=BG, fg=TEXT_PRI,
            font=("Segoe UI", 20, "bold")).pack(side="left")
        tk.Button(hdr, text="⟳  Refresh", bg=SURFACE, fg=TEXT_SEC,
            font=("Segoe UI", 10), relief="flat", cursor="hand2",
            highlightbackground=BORDER, highlightthickness=1,
            padx=12, pady=5,
            command=self._refresh_dashboard).pack(side="right")

        self._dash_sub = tk.Label(p, text="Overview of all defects — updated live",
            bg=BG, fg=TEXT_MUTED, font=("Segoe UI", 11))
        self._dash_sub.grid(row=1, column=0, sticky="w", padx=28, pady=(4, 16))

        # Stat cards row
        cards = tk.Frame(p, bg=BG)
        cards.grid(row=2, column=0, sticky="ew", padx=28, pady=(0, 18))
        for i in range(4):
            cards.columnconfigure(i, weight=1)

        self._stat_vals = {}
        defs = [
            ("total",    "Total Defects",    TEXT_PRI, "#3b82f6"),
            ("open",     "Open Defects",     RED,      RED),
            ("closed",   "Closed Defects",   GREEN,    GREEN),
            ("critical", "Critical Defects", BRAND,    BRAND),
        ]
        for i, (key, lbl, val_fg, _) in enumerate(defs):
            card = tk.Frame(cards, bg=SURFACE,
                highlightbackground=BORDER, highlightthickness=1)
            card.grid(row=0, column=i,
                padx=(0 if i == 0 else 8, 0), sticky="nsew",
                ipadx=16, ipady=10)
            tk.Label(card, text=lbl, bg=SURFACE, fg=TEXT_MUTED,
                font=("Segoe UI", 10)).pack(anchor="w", padx=16, pady=(14, 4))
            v = tk.Label(card, text="0", bg=SURFACE, fg=val_fg,
                font=("Segoe UI", 28, "bold"))
            v.pack(anchor="w", padx=16, pady=(0, 14))
            self._stat_vals[key] = v

        # Recent defects table
        tcard = tk.Frame(p, bg=SURFACE,
            highlightbackground=BORDER, highlightthickness=1)
        tcard.grid(row=3, column=0, sticky="nsew", padx=28, pady=(0, 28))
        tcard.rowconfigure(2, weight=1)
        tcard.columnconfigure(0, weight=1)

        tk.Label(tcard, text="Recent Defects", bg=SURFACE, fg=TEXT_PRI,
            font=("Segoe UI", 12, "bold")).grid(
            row=0, column=0, sticky="w", padx=18, pady=(12, 6))
        ttk.Separator(tcard).grid(row=1, column=0, columnspan=2, sticky="ew")

        cols = ("ID", "Title", "Priority", "Status", "Assigned To", "Date")
        self._dash_tree = ttk.Treeview(tcard, columns=cols,
            show="headings", height=9)
        for col, w in zip(cols, (80, 340, 90, 110, 140, 100)):
            self._dash_tree.heading(col, text=col)
            self._dash_tree.column(col, width=w, minwidth=50)
        vsb = ttk.Scrollbar(tcard, orient="vertical",
            command=self._dash_tree.yview)
        self._dash_tree.configure(yscrollcommand=vsb.set)
        self._dash_tree.grid(row=2, column=0, sticky="nsew", padx=1, pady=1)
        vsb.grid(row=2, column=1, sticky="ns")
        self._apply_tree_tags(self._dash_tree)

    def _refresh_dashboard(self):
        d = self.defects
        total    = len(d)
        open_    = sum(1 for x in d if x.get("status","").lower() == "open")
        closed   = sum(1 for x in d if x.get("status","").lower() == "closed")
        critical = sum(1 for x in d if x.get("priority","").lower() == "critical")
        self._stat_vals["total"].config(text=str(total))
        self._stat_vals["open"].config(text=str(open_))
        self._stat_vals["closed"].config(text=str(closed))
        self._stat_vals["critical"].config(text=str(critical))

        t = self._dash_tree
        t.delete(*t.get_children())
        for rec in reversed(d[-10:]):
            pri = rec.get("priority", "")
            t.insert("", "end", values=(
                rec.get("id",""), rec.get("title",""), pri,
                rec.get("status",""), rec.get("assigned_to",""), rec.get("date","")
            ), tags=(pri.lower(),))

