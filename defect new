    def _project_card(self, parent, name, color, icon, desc):
        proj_defects = [d for d in ALL_DEFECTS if d.get("project") == name]
        open_c = sum(1 for d in proj_defects if d.get("status") == "Open")

        card = tk.Frame(parent, bg=SURFACE,
                        highlightbackground=BORDER,
                        highlightthickness=1,
                        cursor="hand2")
        card.pack(side="left", padx=18)

        # Top accent bar
        tk.Frame(card, bg=color, height=5).pack(fill="x")

        body = tk.Frame(card, bg=SURFACE)
        body.pack(padx=30, pady=26)

        # Icon
        ic = tk.Canvas(body, width=52, height=52,
                        bg=SURFACE, highlightthickness=0)
        ic.pack(anchor="w", pady=(0, 14))
        # Soft circle behind icon
        ic.create_oval(2, 2, 50, 50, fill=color + "22", outline=color, width=1)
        ic.create_text(26, 26, text=icon, fill=color, font=("Segoe UI", 19))

        tk.Label(body, text=f"Project  {name}",
                 bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 16, "bold")).pack(anchor="w")
        tk.Label(body, text=desc,
                 bg=SURFACE, fg=TEXT_SEC,
                 font=("Segoe UI", 10), justify="left").pack(anchor="w", pady=(4, 16))

        # Stats strip
        stats = tk.Frame(body, bg="#f4f5f7",
                         highlightbackground=BORDER,
                         highlightthickness=1)
        stats.pack(fill="x", pady=(0, 18), ipadx=10, ipady=8)
        tk.Label(stats, text=f"{len(proj_defects)} defects  •  {open_c} open",
                 bg="#f4f5f7", fg=TEXT_SEC,
                 font=("Segoe UI", 10)).pack()

        # Open button
        btn = tk.Button(body, text=f"Open {name}  →",
                        bg=color, fg="#fff",
                        font=("Segoe UI", 11, "bold"),
                        relief="flat", cursor="hand2",
                        activebackground=BRAND_DARK, activeforeground="#fff",
                        pady=10,
                        command=lambda p=name: self._open(p))
        btn.pack(fill="x")

        # Hover
        def on_enter(e):
            card.config(highlightbackground=color, highlightthickness=2)
        def on_leave(e):
            card.config(highlightbackground=BORDER, highlightthickness=1)

        for w in (card, body, btn):
            w.bind("<Enter>", on_enter)
            w.bind("<Leave>", on_leave)

    def _open(self, project):
        self.root.destroy()
        r = tk.Tk()
        DashboardWindow(r, project)
        r.mainloop()

    def _logout(self):
        if messagebox.askyesno("Logout", "Are you sure you want to logout?"):
            self.root.destroy()
            r = tk.Tk()
            LoginWindow(r)
            r.mainloop()


