#  DEFECT MANAGEMENT DASHBOARD
# ══════════════════════════════════════════════════════════════════════════════
class DefectDashboard:
    def __init__(self, root: tk.Tk, project: str):
        self.root = root
        self.project = project
        root.title(f"Defect Tracker — Project {project}")
        root.configure(bg=BG)
        root.resizable(True, True)
        root.state("zoomed") if os.name == "nt" else root.attributes("-zoomed", True)
        self._current_view = "list"
        self._build()

    def _get_defects(self):
        return [d for d in ALL_DEFECTS if d.get("project") == self.project]

    def _build(self):
        root = self.root
        root.columnconfigure(1, weight=1)
        root.rowconfigure(0, weight=1)

        # ── Sidebar ────────────────────────────────────────────────────
        self._sidebar = tk.Frame(root, bg=SIDEBAR_BG, width=220)
        self._sidebar.grid(row=0, column=0, sticky="nsew")
        self._sidebar.pack_propagate(False)
        self._build_sidebar()

        # ── Main area ──────────────────────────────────────────────────
        self._main = tk.Frame(root, bg=BG)
        self._main.grid(row=0, column=1, sticky="nsew")
        self._main.columnconfigure(0, weight=1)
        self._main.rowconfigure(1, weight=1)

        self._show_list()

    def _build_sidebar(self):
        sb = self._sidebar

        # Logo
        logo = tk.Frame(sb, bg=SIDEBAR_BG)
        logo.pack(fill="x", pady=(20, 4), padx=18)
        c = tk.Canvas(logo, width=34, height=34, bg=SIDEBAR_BG, highlightthickness=0)
        c.pack(side="left")
        c.create_oval(2, 2, 32, 32, fill=BRAND, outline="")
        c.create_text(17, 17, text="DT", fill="white", font=("Segoe UI", 10, "bold"))
        tk.Label(logo, text=" Defect Tracker", bg=SIDEBAR_BG,
                 fg="#fff", font=("Segoe UI", 12, "bold")).pack(side="left")

        # Project pill
        proj_pill = tk.Frame(sb, bg=BRAND + "33",
                              highlightbackground=BRAND,
                              highlightthickness=1)
        proj_pill.pack(fill="x", padx=18, pady=(14, 20), ipady=7)
        tk.Label(proj_pill, text=f"Project  {self.project}",
                 bg=BRAND + "33", fg=BRAND,
                 font=("Segoe UI", 11, "bold")).pack()

        tk.Frame(sb, bg="#2d3f5a", height=1).pack(fill="x", padx=18, pady=(0, 16))

        # Nav items
        self._nav_btns = {}
        nav_items = [
            ("create",  "＋ Create Defect"),
            ("edit",    "✎  Edit Defect"),
            ("view",    "≡  View Defects"),
            ("results", "◎  View Results"),
        ]
        for key, label in nav_items:
            btn = tk.Button(sb, text=label,
                            bg=SIDEBAR_BG, fg="#c9d3e0",
                            font=("Segoe UI", 11),
                            relief="flat", anchor="w",
                            padx=20, pady=10, cursor="hand2",
                            activebackground=SIDEBAR2,
                            activeforeground="#fff",
                            command=lambda k=key: self._nav(k))
            btn.pack(fill="x", padx=8, pady=2)
            btn.bind("<Enter>", lambda e, b=btn: b.config(bg=SIDEBAR2, fg="#fff"))
            btn.bind("<Leave>", lambda e, b=btn, k=key: b.config(
                bg=BRAND if self._current_view == k else SIDEBAR_BG,
                fg="#fff" if self._current_view == k else "#c9d3e0"))
            self._nav_btns[key] = btn

        # Spacer
        tk.Frame(sb, bg=SIDEBAR_BG).pack(fill="both", expand=True)

        # Bottom buttons
        tk.Frame(sb, bg="#2d3f5a", height=1).pack(fill="x", padx=18, pady=(0, 10))

        back_btn = tk.Button(sb, text="← Projects",
                              bg=SIDEBAR_BG, fg=TEXT_SEC,
                              font=("Segoe UI", 10), relief="flat",
                              padx=20, pady=8, cursor="hand2",
                              command=self._go_back)
        back_btn.pack(fill="x", padx=8, pady=2)

        logout_btn = tk.Button(sb, text="⏻  Logout",
                               bg=SIDEBAR_BG, fg=TEXT_SEC,
                               font=("Segoe UI", 10), relief="flat",
                               padx=20, pady=8, cursor="hand2",
                               command=self._logout)
        logout_btn.pack(fill="x", padx=8, pady=(2, 14))

    def _nav(self, key):
        self._current_view = key
        # Update button colors
        for k, b in self._nav_btns.items():
            if k == key:
                b.config(bg=BRAND, fg="#fff")
            else:
                b.config(bg=SIDEBAR_BG, fg="#c9d3e0")

        for w in self._main.winfo_children():
            w.destroy()

        if key == "create":
            self._show_create()
        elif key == "edit":
            self._show_edit()
        elif key == "view":
            self._show_list()
        elif key == "results":
            self._show_results()

    def _clear_main(self):
        for w in self._main.winfo_children():
            w.destroy()

    # ── Top bar helper ─────────────────────────────────────────────────
    def _top_bar(self, title, subtitle=""):
        bar = tk.Frame(self._main, bg=SURFACE,
                       highlightbackground=BORDER, highlightthickness=1)
        bar.pack(fill="x")
        inner = tk.Frame(bar, bg=SURFACE)
        inner.pack(fill="x", padx=28, pady=16)
        tk.Label(inner, text=title, bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 18, "bold")).pack(anchor="w")
        if subtitle:
            tk.Label(inner, text=subtitle, bg=SURFACE, fg=TEXT_SEC,
                     font=("Segoe UI", 10)).pack(anchor="w", pady=(2, 0))

    # ── Scrollable canvas ──────────────────────────────────────────────
    def _scrollable(self):
        frame = tk.Frame(self._main, bg=BG)
        frame.pack(fill="both", expand=True)
        frame.columnconfigure(0, weight=1)
        frame.rowconfigure(0, weight=1)

        canvas = tk.Canvas(frame, bg=BG, highlightthickness=0)
        vsb = ttk.Scrollbar(frame, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=vsb.set)
        canvas.grid(row=0, column=0, sticky="nsew")
        vsb.grid(row=0, column=1, sticky="ns")

        inner = tk.Frame(canvas, bg=BG)
        win_id = canvas.create_window((0, 0), window=inner, anchor="nw")

        def on_configure(e):
            canvas.configure(scrollregion=canvas.bbox("all"))
        def on_canvas_resize(e):
            canvas.itemconfig(win_id, width=e.width)

        inner.bind("<Configure>", on_configure)
        canvas.bind("<Configure>", on_canvas_resize)
        canvas.bind("<MouseWheel>",
            lambda e: canvas.yview_scroll(-1*(e.delta//120), "units"))
        return inner

    # ════════════════════════════════════════════════════════════════════
    #  VIEW DEFECTS
    # ════════════════════════════════════════════════════════════════════
    def _show_list(self):
        self._clear_main()
        self._current_view = "view"
        for k, b in self._nav_btns.items():
            b.config(bg=BRAND if k == "view" else SIDEBAR_BG,
                     fg="#fff" if k == "view" else "#c9d3e0")

        defects = self._get_defects()
        self._top_bar(f"Defects — {self.project}",
                      f"{len(defects)} defect(s) found")

        scroll = self._scrollable()

        if not defects:
            tk.Label(scroll, text="No defects found. Create one!",
                     bg=BG, fg=TEXT_SEC,
                     font=("Segoe UI", 13)).pack(pady=60)
            return

        # Header row
        header = tk.Frame(scroll, bg="#e8eaed")
        header.pack(fill="x", padx=24, pady=(20, 0))
        for col, w, anchor in [
            ("ID", 60, "center"), ("Title", 280, "w"),
            ("Priority", 90, "center"), ("Status", 90, "center"),
            ("Created", 130, "center")
        ]:
            tk.Label(header, text=col, bg="#e8eaed", fg=TEXT_SEC,
                     font=("Segoe UI", 10, "bold"),
                     width=w//7, anchor=anchor).pack(side="left", padx=6, pady=8)

        for d in reversed(defects):
            self._defect_row(scroll, d)

    def _defect_row(self, parent, d):
        pri_colors = {"Critical": RED_C, "Major": ORANGE, "Minor": BLUE, "Low": GREEN}
        sta_colors = {"Open": RED_C, "In Progress": ORANGE, "Closed": GREEN, "Resolved": BLUE}
        pri = d.get("priority", "Minor")
        sta = d.get("status", "Open")

        row = tk.Frame(parent, bg=SURFACE,
                       highlightbackground=BORDER,
                       highlightthickness=1)
        row.pack(fill="x", padx=24, pady=4)

        inner = tk.Frame(row, bg=SURFACE)
        inner.pack(fill="x", padx=12, pady=10)

        # ID
        tk.Label(inner, text=f"#{d.get('id','?')}",
                 bg=SURFACE, fg=TEXT_MUT,
                 font=("Segoe UI", 10), width=5,
                 anchor="center").pack(side="left", padx=4)

        # Title
        tk.Label(inner, text=d.get("title", "Untitled"),
                 bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 11), width=32,
                 anchor="w").pack(side="left", padx=8)

        # Priority badge
        pc = pri_colors.get(pri, TEXT_SEC)
        pri_lbl = tk.Label(inner, text=pri,
                           bg=pc + "18", fg=pc,
                           font=("Segoe UI", 9, "bold"),
                           padx=10, pady=3, width=9, anchor="center")
        pri_lbl.pack(side="left", padx=6)

        # Status badge
        sc = sta_colors.get(sta, TEXT_SEC)
        tk.Label(inner, text=sta,
                 bg=sc + "18", fg=sc,
                 font=("Segoe UI", 9, "bold"),
                 padx=10, pady=3, width=9, anchor="center").pack(side="left", padx=6)

        # Date
        tk.Label(inner, text=d.get("created", "—"),
                 bg=SURFACE, fg=TEXT_MUT,
                 font=("Segoe UI", 10), width=14,
                 anchor="center").pack(side="left", padx=6)

    # ════════════════════════════════════════════════════════════════════
    #  CREATE DEFECT
    # ════════════════════════════════════════════════════════════════════
    def _show_create(self):
        self._clear_main()
        self._top_bar("Create Defect", f"Log a new defect for Project {self.project}")

        scroll = self._scrollable()
        form = tk.Frame(scroll, bg=SURFACE,
                        highlightbackground=BORDER, highlightthickness=1)
        form.pack(padx=28, pady=20, fill="x")

        body = tk.Frame(form, bg=SURFACE)
        body.pack(padx=28, pady=24, fill="x")

        fields = {}

        def field(label, widget_fn):
            tk.Label(body, text=label, bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(14, 4))
            w = widget_fn()
            w.pack(fill="x")
            return w

        # Title
        title_var = tk.StringVar()
        field("Title *", lambda: tk.Entry(body, textvariable=title_var,
              bg="#f9fafb", fg=TEXT_PRI, font=("Segoe UI", 12),
              relief="flat", highlightbackground=BORDER, highlightthickness=1))
        fields["title"] = title_var

        # Description
        tk.Label(body, text="Description", bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(14, 4))
        desc_txt = tk.Text(body, height=4, bg="#f9fafb", fg=TEXT_PRI,
                           font=("Segoe UI", 11), relief="flat",
                           highlightbackground=BORDER, highlightthickness=1)
        desc_txt.pack(fill="x")

        # Priority + Status row
        row2 = tk.Frame(body, bg=SURFACE)
        row2.pack(fill="x", pady=(14, 0))
        row2.columnconfigure(0, weight=1)
        row2.columnconfigure(1, weight=1)

        pri_var = tk.StringVar(value="Minor")
        sta_var = tk.StringVar(value="Open")

        for col, lbl, var, opts in [
            (0, "Priority", pri_var, ["Critical","Major","Minor","Low"]),
            (1, "Status",   sta_var, ["Open","In Progress","Closed","Resolved"]),
        ]:
            f = tk.Frame(row2, bg=SURFACE)
            f.grid(row=0, column=col, padx=(0 if col==0 else 12, 0), sticky="ew")
            tk.Label(f, text=lbl, bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0,4))
            cb = ttk.Combobox(f, textvariable=var, values=opts,
                              state="readonly", font=("Segoe UI", 11))
            cb.pack(fill="x", ipady=5)

        # Assignee
        assign_var = tk.StringVar()
        tk.Label(body, text="Assignee", bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(14, 4))
        tk.Entry(body, textvariable=assign_var,
                 bg="#f9fafb", fg=TEXT_PRI, font=("Segoe UI", 12),
                 relief="flat", highlightbackground=BORDER,
                 highlightthickness=1).pack(fill="x", ipady=6)

        # Submit
        def submit():
            title = title_var.get().strip()
            if not title:
                messagebox.showerror("Error", "Title is required.")
                return
            new_id = max((d.get("id", 0) for d in ALL_DEFECTS), default=0) + 1
            defect = {
                "id": new_id,
                "project": self.project,
                "title": title,
                "description": desc_txt.get("1.0", "end").strip(),
                "priority": pri_var.get(),
                "status": sta_var.get(),
                "assignee": assign_var.get().strip(),
                "created": datetime.date.today().strftime("%d %b %Y"),
            }
            ALL_DEFECTS.append(defect)
            save_defects(ALL_DEFECTS)
            messagebox.showinfo("Success", f"Defect #{new_id} created!")
            title_var.set("")
            desc_txt.delete("1.0", "end")
            assign_var.set("")

        tk.Button(body, text="Create Defect",
                  bg=BRAND, fg="#fff",
                  font=("Segoe UI", 12, "bold"),
                  relief="flat", cursor="hand2",
                  activebackground=BRAND_DARK, activeforeground="#fff",
                  pady=11,
                  command=submit).pack(fill="x", pady=(24, 0))

    # ════════════════════════════════════════════════════════════════════
    #  EDIT DEFECT
    # ════════════════════════════════════════════════════════════════════
    def _show_edit(self):
        self._clear_main()
        self._top_bar("Edit Defect", f"Modify an existing defect in Project {self.project}")

        scroll = self._scrollable()
        defects = self._get_defects()

        if not defects:
            tk.Label(scroll, text="No defects to edit. Create one first!",
                     bg=BG, fg=TEXT_SEC,
                     font=("Segoe UI", 13)).pack(pady=60)
            return

        # Select defect
        sel_frame = tk.Frame(scroll, bg=SURFACE,
                             highlightbackground=BORDER, highlightthickness=1)
        sel_frame.pack(padx=28, pady=20, fill="x")
        sel_body = tk.Frame(sel_frame, bg=SURFACE)
        sel_body.pack(padx=28, pady=20, fill="x")

        tk.Label(sel_body, text="Select Defect to Edit",
                 bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 13, "bold")).pack(anchor="w", pady=(0, 10))

        choices = [f"#{d['id']} — {d['title']}" for d in defects]
        sel_var = tk.StringVar(value=choices[0])
        sel_cb = ttk.Combobox(sel_body, textvariable=sel_var,
                              values=choices, state="readonly",
                              font=("Segoe UI", 12), width=50)
        sel_cb.pack(fill="x", ipady=6)

        # Edit form (below selector)
        edit_container = tk.Frame(scroll, bg=BG)
        edit_container.pack(fill="x", padx=28, pady=(0, 20))

        self._edit_widgets = {}

        def load_defect(*args):
            for w in edit_container.winfo_children():
                w.destroy()

            idx = choices.index(sel_var.get())
            d = defects[idx]

            form = tk.Frame(edit_container, bg=SURFACE,
                            highlightbackground=BORDER, highlightthickness=1)
            form.pack(fill="x")
            body = tk.Frame(form, bg=SURFACE)
            body.pack(padx=28, pady=24, fill="x")

            title_var = tk.StringVar(value=d.get("title",""))
            tk.Label(body, text="Title *", bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0,4))
            tk.Entry(body, textvariable=title_var,
                     bg="#f9fafb", fg=TEXT_PRI, font=("Segoe UI", 12),
                     relief="flat", highlightbackground=BORDER,
                     highlightthickness=1).pack(fill="x", ipady=6)

            tk.Label(body, text="Description", bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(14,4))
            desc_txt = tk.Text(body, height=4, bg="#f9fafb", fg=TEXT_PRI,
                               font=("Segoe UI", 11), relief="flat",
                               highlightbackground=BORDER, highlightthickness=1)
            desc_txt.insert("1.0", d.get("description",""))
            desc_txt.pack(fill="x")

            row2 = tk.Frame(body, bg=SURFACE)
            row2.pack(fill="x", pady=(14,0))
            row2.columnconfigure(0, weight=1)
            row2.columnconfigure(1, weight=1)

            pri_var = tk.StringVar(value=d.get("priority","Minor"))
            sta_var = tk.StringVar(value=d.get("status","Open"))
            for col, lbl, var, opts in [
                (0,"Priority",pri_var,["Critical","Major","Minor","Low"]),
                (1,"Status",  sta_var,["Open","In Progress","Closed","Resolved"]),
            ]:
                f = tk.Frame(row2, bg=SURFACE)
                f.grid(row=0, column=col, padx=(0 if col==0 else 12,0), sticky="ew")
                tk.Label(f, text=lbl, bg=SURFACE, fg=TEXT_PRI,
                         font=("Segoe UI",11,"bold")).pack(anchor="w", pady=(0,4))
                cb = ttk.Combobox(f, textvariable=var, values=opts,
                                  state="readonly", font=("Segoe UI",11))
                cb.pack(fill="x", ipady=5)

            assign_var = tk.StringVar(value=d.get("assignee",""))
            tk.Label(body, text="Assignee", bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI",11,"bold")).pack(anchor="w", pady=(14,4))
            tk.Entry(body, textvariable=assign_var,
                     bg="#f9fafb", fg=TEXT_PRI, font=("Segoe UI",12),
                     relief="flat", highlightbackground=BORDER,
                     highlightthickness=1).pack(fill="x", ipady=6)

            def save_edit():
                title = title_var.get().strip()
                if not title:
                    messagebox.showerror("Error","Title is required.")
                    return
                d["title"]       = title
                d["description"] = desc_txt.get("1.0","end").strip()
                d["priority"]    = pri_var.get()
                d["status"]      = sta_var.get()
                d["assignee"]    = assign_var.get().strip()
                save_defects(ALL_DEFECTS)
                messagebox.showinfo("Saved",f"Defect #{d['id']} updated!")

            tk.Button(body, text="Save Changes",
                      bg=BRAND, fg="#fff",
                      font=("Segoe UI",12,"bold"),
                      relief="flat", cursor="hand2",
                      activebackground=BRAND_DARK, activeforeground="#fff",
                      pady=11,
                      command=save_edit).pack(fill="x", pady=(24,0))

        sel_var.trace_add("write", load_defect)
        load_defect()

    # ════════════════════════════════════════════════════════════════════
    #  VIEW RESULTS
    # ════════════════════════════════════════════════════════════════════
    def _show_results(self):
        self._clear_main()
        self._top_bar("View Results", f"Defect analytics for Project {self.project}")

        scroll = self._scrollable()
        defects = self._get_defects()

        # ── Summary cards ──────────────────────────────────────────────
        cards_row = tk.Frame(scroll, bg=BG)
        cards_row.pack(fill="x", padx=28, pady=20)

        total  = len(defects)
        open_c = sum(1 for d in defects if d.get("status")=="Open")
        in_prog= sum(1 for d in defects if d.get("status")=="In Progress")
        closed = sum(1 for d in defects if d.get("status") in ("Closed","Resolved"))

        for lbl, val, col in [
            ("Total",      total,   TEXT_PRI),
            ("Open",       open_c,  RED_C),
            ("In Progress",in_prog, ORANGE),
            ("Closed",     closed,  GREEN),
        ]:
            card = tk.Frame(cards_row, bg=SURFACE,
                            highlightbackground=BORDER, highlightthickness=1)
            card.pack(side="left", expand=True, fill="x", padx=6, ipadx=10, ipady=14)
            tk.Label(card, text=str(val), bg=SURFACE,
                     fg=col, font=("Segoe UI",24,"bold")).pack()
            tk.Label(card, text=lbl, bg=SURFACE,
                     fg=TEXT_SEC, font=("Segoe UI",10)).pack()

        # ── Priority breakdown ─────────────────────────────────────────
        tk.Frame(scroll, bg=BORDER, height=1).pack(fill="x", padx=28, pady=(10,20))

        two_col = tk.Frame(scroll, bg=BG)
        two_col.pack(fill="x", padx=28, pady=(0,20))
        two_col.columnconfigure(0, weight=1)
        two_col.columnconfigure(1, weight=1)

        # Priority
        self._stat_card(two_col, 0, "Priority Breakdown", [
            ("Critical", sum(1 for d in defects if d.get("priority")=="Critical"), RED_C),
            ("Major",    sum(1 for d in defects if d.get("priority")=="Major"),    ORANGE),
            ("Minor",    sum(1 for d in defects if d.get("priority")=="Minor"),    BLUE),
            ("Low",      sum(1 for d in defects if d.get("priority")=="Low"),      GREEN),
        ], total)

        # Status
        self._stat_card(two_col, 1, "Status Breakdown", [
            ("Open",        open_c,  RED_C),
            ("In Progress", in_prog, ORANGE),
            ("Closed",      sum(1 for d in defects if d.get("status")=="Closed"),  GREEN),
            ("Resolved",    sum(1 for d in defects if d.get("status")=="Resolved"),BLUE),
        ], total)

        # ── Recent defects table ───────────────────────────────────────
        recent_frame = tk.Frame(scroll, bg=SURFACE,
                                highlightbackground=BORDER, highlightthickness=1)
        recent_frame.pack(fill="x", padx=28, pady=(0,28))
        tk.Frame(recent_frame, bg=SURFACE).pack(padx=20, pady=(16,0))
        tk.Label(recent_frame, text="Recent Defects",
                 bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI",13,"bold")).pack(anchor="w", padx=20)

        cols = ("ID","Title","Priority","Status","Assignee","Created")
        style = ttk.Style()
        style.configure("Treeview", font=("Segoe UI",10), rowheight=32)
        style.configure("Treeview.Heading", font=("Segoe UI",10,"bold"))

        tree = ttk.Treeview(recent_frame, columns=cols, show="headings", height=8)
        for c, w in zip(cols,[50,260,90,100,110,110]):
            tree.heading(c, text=c)
            tree.column(c, width=w, anchor="center" if c!="Title" else "w")
        tree.pack(fill="x", padx=20, pady=(10,20))

        pri_colors = {"Critical": RED_C, "Major": ORANGE, "Minor": BLUE, "Low": GREEN}
        for d in reversed(defects[-20:]):
            tree.insert("", "end", values=(
                f"#{d.get('id','?')}",
                d.get("title",""),
                d.get("priority",""),
                d.get("status",""),
                d.get("assignee","—"),
                d.get("created",""),
            ))

    def _stat_card(self, parent, col, title, items, total):
        card = tk.Frame(parent, bg=SURFACE,
                        highlightbackground=BORDER, highlightthickness=1)
        card.grid(row=0, column=col,
                  padx=(0 if col==0 else 12, 0), sticky="nsew")
        body = tk.Frame(card, bg=SURFACE)
        body.pack(padx=20, pady=18, fill="x")
        tk.Label(body, text=title, bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI",12,"bold")).pack(anchor="w", pady=(0,12))

        for lbl, count, color in items:
            row = tk.Frame(body, bg=SURFACE)
            row.pack(fill="x", pady=4)
            tk.Label(row, text=lbl, bg=SURFACE, fg=TEXT_SEC,
                     font=("Segoe UI",10), width=12, anchor="w").pack(side="left")

            bar_bg = tk.Frame(row, bg="#f0f2f5", height=10)
            bar_bg.pack(side="left", fill="x", expand=True, padx=(8,8))
            bar_bg.pack_propagate(False)

            pct = int((count/total)*100) if total else 0
            if pct > 0:
                bar = tk.Frame(bar_bg, bg=color, height=10)
                bar.place(relx=0, rely=0, relwidth=pct/100, relheight=1)

            tk.Label(row, text=str(count), bg=SURFACE, fg=color,
                     font=("Segoe UI",10,"bold"), width=3, anchor="e").pack(side="right")

