<!-- ═══ PROFESSIONAL TOAST CONTAINER ═══ -->

<div class="toast-container" id="toastContainer"></div>

<script>

// In-memory defect store (localStorage)

var DEFECTS_KEY = 'lg_defects';

function getDefects() {

  try { return JSON.parse(localStorage.getItem(DEFECTS_KEY)) || []; } catch(e) { return []; }

}

function saveDefects(arr) {

  localStorage.setItem(DEFECTS_KEY, JSON.stringify(arr));

}

// ═══ USER DATA BOOTSTRAP ═══

(function() {

  var raw = localStorage.getItem('user');

  if (!raw) return;

  var u; try { u = JSON.parse(raw); } catch(e) { return; }

  var firstName = u.firstName || '', lastName = u.lastName || '';

  var fullName  = (firstName + ' ' + lastName).trim() || 'User';

  var initials  = ((firstName[0]||'') + (lastName[0]||'')).toUpperCase() || 'U';

  var el; 

  if ((el = document.querySelector('.nav-avatar'))) el.textContent = initials;

  if ((el = document.querySelector('.nav-name')))   el.textContent = fullName;

  if ((el = document.getElementById('dashWelcome'))) el.textContent = 'Welcome back, ' + firstName + '! Here\'s your defect overview.';

  if ((el = document.getElementById('settingFullName'))) el.value = fullName;

  if ((el = document.getElementById('settingEmail')))    el.value = u.email || '';

  if ((el = document.getElementById('settingPhone')) && u.phone) el.value = u.phone;

})();

function saveProfile() {

  var raw = localStorage.getItem('user'), u = raw ? JSON.parse(raw) : {};

  var fullName = (document.getElementById('settingFullName').value||'').trim();

  var parts = fullName.split(' ');

  u.firstName = parts[0]||u.firstName; u.lastName = parts.slice(1).join(' ')||u.lastName;

  u.email = document.getElementById('settingEmail').value.trim()||u.email;

  u.phone = document.getElementById('settingPhone').value.trim()||u.phone;

  localStorage.setItem('user', JSON.stringify(u));

  var el;

  var initials = ((u.firstName||'')[0]+(u.lastName||'')[0]).toUpperCase();

  if ((el=document.querySelector('.nav-avatar'))) el.textContent = initials;

  if ((el=document.querySelector('.nav-name')))   el.textContent = fullName;

  showToast('success','Profile updated','Your profile has been saved successfully.');

}

// ═══ TOAST SYSTEM ═══

var toastIcons = {

  success: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>',

  error:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',

  info:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>',

  warning: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>'

};

function showToast(type, title, message) {

  var container = document.getElementById('toastContainer');

  var toast = document.createElement('div');

  toast.className = 'toast-item toast-' + type;

  toast.innerHTML = '<div class="toast-icon-wrap">'+toastIcons[type]+'</div><div class="toast-body"><div class="toast-title">'+title+'</div><div class="toast-msg">'+message+'</div></div><button class="toast-close-btn" onclick="dismissToast(this.parentElement)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button><div class="toast-progress-bar"></div>';

  container.appendChild(toast);

  setTimeout(function() { dismissToast(toast); }, 3500);

}

function dismissToast(toast) {

  if (!toast || toast.classList.contains('hiding')) return;

  toast.classList.add('hiding');

  setTimeout(function() { if(toast.parentElement) toast.remove(); }, 300);

}

// ═══ SIDEBAR ═══

function toggleSidebar() {

  document.getElementById('sidebar').classList.toggle('open');

  document.getElementById('sidebarOverlay').classList.toggle('show');

  document.getElementById('hamburger').classList.toggle('open');

}

// ═══ PAGE NAVIGATION ═══

function showPage(name, el) {

  document.querySelectorAll('.page').forEach(function(p){ p.classList.remove('active'); });

  document.querySelectorAll('.nav-item').forEach(function(n){ n.classList.remove('active'); });

  document.getElementById('page-'+name).classList.add('active');

  if (el) el.classList.add('active');

  if (document.getElementById('sidebar').classList.contains('open')) toggleSidebar();

}

// ═══ HELPERS ═══

var sc = { 'Open':'open','Closed':'closed','Critical':'critical','In Progress':'in-progress','Reopen':'reopen','Resolved':'resolved' };

var pc = { 'Critical':'critical','Major':'major','Minor':'minor' };

function shortId(id) {

  return id ? id.toString().slice(-6).toUpperCase() : '—';

}

function fmtDate(d) {

  if (!d) return '—';

  var dt = new Date(d);

  if (isNaN(dt)) return d;

  return dt.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });

}

function barRow(id, label, count, max, color) {

  var pct = max > 0 ? Math.round((count/max)*100) : 0;

  document.getElementById(id+'Fill').style.width = pct + '%';

  document.getElementById(id+'Val').textContent  = count;

}

// ═══ LOAD DEFECTS FROM LOCAL STORAGE ═══

function loadDefects(showMsg) {

  var icon = document.getElementById('refreshIcon');

  if (icon) icon.style.animation = 'spin 0.8s linear infinite';

  var data = getDefects();

  renderTables(data);

  renderStats(data);

  renderReports(data);

  if (showMsg) showToast('info','Refreshed', data.length + ' defect(s) loaded.');

  if (icon) icon.style.animation = '';

}

// ── Render dashboard + view tables ──

function renderTables(defects) {

  var dashBody = document.getElementById('dashTableBody');

  var viewBody = document.getElementById('viewTableBody');

  dashBody.innerHTML = '';

  viewBody.innerHTML = '';

  if (defects.length === 0) {

    dashBody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:28px;font-size:13px;">No defects found.</td></tr>';

    viewBody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:28px;font-size:13px;">No defects found.</td></tr>';

    return;

  }

  // Dashboard: show latest 10 only

  var recent = defects.slice(0, 10);

  recent.forEach(function(d) {

    var id      = shortId(d.id);

    var dateStr = fmtDate(d.date || d.createdAt);

    var priCls  = pc[d.priority] || 'minor';

    var stCls   = sc[d.status]   || 'open';

    dashBody.insertAdjacentHTML('beforeend',

      '<tr><td class="td-id">#'+id+'</td>' +

      '<td class="td-title">'+escHtml(d.title)+'</td>' +

      '<td><span class="pri '+priCls+'">'+escHtml(d.priority)+'</span></td>' +

      '<td><span class="badge '+stCls+'">'+escHtml(d.status)+'</span></td>' +

      '<td>'+escHtml(d.assignedTo||'—')+'</td>' +

      '<td>'+dateStr+'</td></tr>'

    );

  });

  // View Defects: show all

  defects.forEach(function(d) {

    var id      = shortId(d.id);

    var dateStr = fmtDate(d.date || d.createdAt);

    var priCls  = pc[d.priority] || 'minor';

    var stCls   = sc[d.status]   || 'open';

    viewBody.insertAdjacentHTML('beforeend',

      '<tr data-priority="'+escHtml(d.priority)+'" data-status="'+escHtml(d.status)+'">' +

      '<td class="td-id">#'+id+'</td>' +

      '<td class="td-title">'+escHtml(d.title)+'</td>' +

      '<td><span class="pri '+priCls+'">'+escHtml(d.priority)+'</span></td>' +

      '<td><span class="badge '+stCls+'">'+escHtml(d.status)+'</span></td>' +

      '<td>'+escHtml(d.assignedTo||'—')+'</td>' +

      '<td>'+dateStr+'</td></tr>'

    );

  });

}

// ── Render stat cards ──

function renderStats(defects) {

  var total    = defects.length;

  var open     = defects.filter(function(d){ return d.status==='Open'||d.status==='Reopen'; }).length;

  var closed   = defects.filter(function(d){ return d.status==='Closed'||d.status==='Resolved'; }).length;

  var critical = defects.filter(function(d){ return d.status==='Critical'||d.priority==='Critical'; }).length;

  document.getElementById('statTotal').textContent    = total;

  document.getElementById('statOpen').textContent     = open;

  document.getElementById('statClosed').textContent   = closed;

  document.getElementById('statCritical').textContent = critical;

}

// ── Render reports ──

function renderReports(defects) {

  var total = defects.length || 1; // avoid div/0

  // Priority counts

  var priC = defects.filter(function(d){ return d.priority==='Critical'; }).length;

  var priM = defects.filter(function(d){ return d.priority==='Major'; }).length;

  var priN = defects.filter(function(d){ return d.priority==='Minor'; }).length;

  var maxPri = Math.max(priC, priM, priN, 1);

  setBar('rPriCritical', priC, maxPri);

  setBar('rPriMajor',    priM, maxPri);

  setBar('rPriMinor',    priN, maxPri);

  // Status counts

  var stOpen = defects.filter(function(d){ return d.status==='Open'; }).length;

  var stClosed = defects.filter(function(d){ return d.status==='Closed'; }).length;

  var stInProg = defects.filter(function(d){ return d.status==='In Progress'; }).length;

  var stCrit   = defects.filter(function(d){ return d.status==='Critical'; }).length;

  var stRes    = defects.filter(function(d){ return d.status==='Resolved'; }).length;

  var stReopen = defects.filter(function(d){ return d.status==='Reopen'; }).length;

  var maxSt = Math.max(stOpen, stClosed, stInProg, stCrit, stRes, stReopen, 1);

  setBar('rStOpen',       stOpen,   maxSt);

  setBar('rStClosed',     stClosed, maxSt);

  setBar('rStInProgress', stInProg, maxSt);

  setBar('rStCritical',   stCrit,   maxSt);

  setBar('rStResolved',   stRes,    maxSt);

  setBar('rStReopen',     stReopen, maxSt);

  // Assignee counts (dynamic — top 6)

  var assigneeCounts = {};

  defects.forEach(function(d) {

    var a = (d.assignedTo||'Unassigned').trim();

    assigneeCounts[a] = (assigneeCounts[a]||0) + 1;

  });

  var sortedAssignees = Object.entries(assigneeCounts)

    .sort(function(a,b){ return b[1]-a[1]; }).slice(0,6);

  var maxA = sortedAssignees.length ? sortedAssignees[0][1] : 1;

  var colors = ['#6366f1','#a50034','#f59e0b','#22c55e','#3b82f6','#ec4899'];

  var html = '';

  sortedAssignees.forEach(function(entry, i) {

    var pct = Math.round((entry[1]/maxA)*100);

    html += '<div class="bar-row"><span class="bar-label" style="min-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="'+escHtml(entry[0])+'">'+escHtml(entry[0])+'</span>' +

            '<div class="bar-track"><div class="bar-fill" style="width:'+pct+'%;background:'+colors[i%colors.length]+'"></div></div>' +

            '<span class="bar-val">'+entry[1]+'</span></div>';

  });

  if (!html) html = '<div style="color:var(--text-muted);font-size:13px;padding:12px 0">No data yet</div>';

  document.getElementById('rAssigneeRows').innerHTML = html;

  // Resolution rate

  var done = defects.filter(function(d){ return d.status==='Closed'||d.status==='Resolved'; }).length;

  var pct  = defects.length > 0 ? Math.round((done/defects.length)*100) : 0;

  document.getElementById('rResolutionPct').textContent = pct + '%';

  document.getElementById('rResTotal').textContent      = defects.length;

  document.getElementById('rResDone').textContent       = done;

}

function setBar(id, count, max) {

  var pct = Math.round((count/max)*100);

  var fillEl = document.getElementById(id+'Fill');

  var valEl  = document.getElementById(id+'Val');

  if (fillEl) fillEl.style.width = pct + '%';

  if (valEl)  valEl.textContent  = count;

}

function escHtml(str) {

  if (!str) return '';

  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

}

