        af.grid(row=7, column=0, sticky="ew", padx=(0, 8), pady=(0, 14))
        tk.Label(af, text="Assignee", bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0, 4))
        assign_var = tk.StringVar()
        styled_entry(af, textvariable=assign_var).pack(fill="x", ipady=7)

        svf = tk.Frame(body, bg=SURFACE)
        svf.grid(row=7, column=1, sticky="ew", padx=(8, 0), pady=(0, 14))
        tk.Label(svf, text="Severity", bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0, 4))
        sev_var = tk.StringVar(value="Medium")
        ttk.Combobox(svf, textvariable=sev_var,
                     values=["Low", "Medium", "High", "Blocker"],
                     state="readonly", font=("Segoe UI", 11)).pack(fill="x", ipady=5)

        # Divider
        tk.Frame(body, bg=BORDER, height=1).grid(row=8, column=0, columnspan=2,
                                                   sticky="ew", pady=(8, 16))

        def do_create():
            t = title_var.get().strip()
            if not t:
                messagebox.showerror("Validation", "Defect title is required.", parent=dlg)
                return
            new_id = max((d.get("id", 0) for d in APP_DATA["defects"]), default=0) + 1
            new_defect = {
                "id":          new_id,
                "project":     self.project,
                "title":       t,
                "description": desc_box.get("1.0", "end").strip(),
                "priority":    pri_var.get(),
                "status":      sta_var.get(),
                "assignee":    assign_var.get().strip(),
                "severity":    sev_var.get(),
                "steps":       "",
                "created":     datetime.date.today().strftime("%d %b %Y"),
            }
            APP_DATA["defects"].append(new_defect)
            save_data(APP_DATA)
            self._count_lbl.config(text=f"{len(self._proj_defects())} defect(s)")
            dlg.destroy()
            messagebox.showinfo("Created", f"\u2714  Defect #{new_id} created successfully!")

