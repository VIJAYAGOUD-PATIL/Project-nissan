# ── Persistence ───────────────────────────────────────────────────────────────
def load_defects():
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return []

def save_defects(data):
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)

ALL_DEFECTS = load_defects()

# ── Rounded Entry helper ───────────────────────────────────────────────────────
class RoundedEntry(tk.Frame):
    def __init__(self, parent, show="", placeholder="", width=280, **kw):
        super().__init__(parent, bg=SIDEBAR2,
                         highlightbackground="#2d3f5a",
                         highlightthickness=1, bd=0)
        self._ph = placeholder
        self._show = show
        self._active = False
        self.var = tk.StringVar()
        self._entry = tk.Entry(
            self, textvariable=self.var,
            bg=SIDEBAR2, fg=TEXT_MUT,
            insertbackground="#fff",
            font=("Segoe UI", 12), relief="flat",
            bd=0, width=width // 9,
            show="" if placeholder else show
        )
        self._entry.pack(fill="x", padx=14, pady=10)
        if placeholder:
            self._entry.insert(0, placeholder)
        self._entry.bind("<FocusIn>",  self._on_focus)
        self._entry.bind("<FocusOut>", self._off_focus)

    def _on_focus(self, e):
        if not self._active and self._ph:
            self._entry.delete(0, "end")
            self._entry.config(fg="#ffffff", show=self._show)
            self._active = True
        self.config(highlightbackground=BRAND)

    def _off_focus(self, e):
        self.config(highlightbackground="#2d3f5a")
        if not self._entry.get() and self._ph:
            self._entry.insert(0, self._ph)
            self._entry.config(fg=TEXT_MUT, show="")
            self._active = False

    def get(self):
        val = self._entry.get()
        return "" if (val == self._ph and not self._active) else val

    def clear(self):
        self._entry.delete(0, "end")
        if self._ph:
            self._entry.insert(0, self._ph)
            self._entry.config(fg=TEXT_MUT, show="")
            self._active = False


