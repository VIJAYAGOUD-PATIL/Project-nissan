    def _pick_files(self):
        files = filedialog.askopenfilenames(title="Select attachments",
            filetypes=[("All files","*.*")])
        for fp in files:
            if fp not in self._attachments:
                self._attachments.append(fp)
                name = os.path.basename(fp)
                row  = tk.Frame(self._att_list, bg=SURFACE)
                row.pack(fill="x", pady=2)
                tk.Label(row, text=f"📄  {name}",
                    bg=SURFACE, fg=TEXT_SEC,
                    font=("Segoe UI", 10)).pack(side="left", padx=8)
                tk.Button(row, text="×",
                    bg=SURFACE, fg=RED,
                    font=("Segoe UI", 12, "bold"), relief="flat",
                    cursor="hand2",
                    command=lambda r=row, f=fp: (
                        self._attachments.remove(f) if f in self._attachments else None,
                        r.destroy()
                    )).pack(side="right", padx=4)

    def _submit_defect(self):
        def val(key):
            v = self._cf[key].get().strip()
            return "" if v in ("Brief description of the defect", "Name",
                               "TC-001", "Bug / Feature / Task",
                               "e.g. DEF-100") else v

        title    = val("title")
        status   = self._cf["status"].get()
        priority = self._cf["priority"].get()
        assigned = val("assigned_to")
        date_v   = self._cf["date"].get().strip()

        if not title:
            messagebox.showerror("Validation", "Title is required."); return
        if not status:
            messagebox.showerror("Validation", "Status is required."); return
        if not priority:
            messagebox.showerror("Validation", "Priority is required."); return
        if not assigned:
            messagebox.showerror("Validation", "Assigned To is required."); return

        desc = self._desc.get("1.0","end").strip()
        if desc == "Enter description, steps to reproduce, expected vs actual results…":
            desc = ""

        new_id = f"DEF-{len(self.defects)+1:04d}"
        rec = {"id": new_id}
        for k, sv in self._cf.items():
            raw = sv.get()
            rec[k] = "" if raw in ("Brief description of the defect","Name",
                                   "TC-001","Bug / Feature / Task",
                                   "e.g. DEF-100") else raw
        rec["description"] = desc
        rec["attachments"]  = self._attachments[:]
        if not rec.get("date"):
            rec["date"] = str(datetime.date.today())

        self.defects.append(rec)
        save_defects(self.defects)
        self._reset_create_form()
        messagebox.showinfo("Success", f"Defect {new_id} created!")
        self.show_page("view")

    def _reset_create_form(self):
        for k, sv in self._cf.items():
            if k == "date":
                sv.set(str(datetime.date.today()))
            else:
                sv.set("")
        self._desc.delete("1.0","end")
        self._desc.insert("1.0",
            "Enter description, steps to reproduce, expected vs actual results…")
        self._desc.config(fg=TEXT_MUTED)
        for w in self._att_list.winfo_children():
            w.destroy()
        self._attachments.clear()

