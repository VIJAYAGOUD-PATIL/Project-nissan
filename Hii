        for col, w in zip(cols, (85, 350, 90, 110, 150, 100)):
            self._vtree.heading(col, text=col,
                command=lambda c=col: self._sort_view(c))
            self._vtree.column(col, width=w, minwidth=50)

        vsb = ttk.Scrollbar(tcard, orient="vertical",   command=self._vtree.yview)
        hsb = ttk.Scrollbar(tcard, orient="horizontal", command=self._vtree.xview)
        self._vtree.configure(yscrollcommand=vsb.set, xscrollcommand=hsb.set)
        self._vtree.grid(row=0, column=0, sticky="nsew", padx=1, pady=1)
        vsb.grid(row=0, column=1, sticky="ns")
        hsb.grid(row=1, column=0, sticky="ew")
        self._apply_tree_tags(self._vtree)

        # Right-click context menu
        ctx = tk.Menu(self.root, tearoff=0)
        ctx.add_command(label="🗑  Delete selected",
            command=self._delete_selected)
        self._vtree.bind("<Button-3>",
            lambda e: ctx.post(e.x_root, e.y_root))
        self._vtree.bind("<Delete>",
            lambda e: self._delete_selected())

    def _sort_view(self, col):
        if self._sort_col == col:
            self._sort_rev = not self._sort_rev
        else:
            self._sort_col, self._sort_rev = col, False
        self._refresh_view()

    def _refresh_view(self):
        raw = self._vsearch.get().strip()
        search = "" if raw == "Search by title…" else raw.lower()
        pri = self._fPri.get()
        st  = self._fSt.get()

        data = self.defects[:]
        if search:
            data = [d for d in data
                    if search in d.get("title","").lower()]
        if pri and pri != "All Priorities":
            data = [d for d in data
                    if d.get("priority","").lower() == pri.lower()]
        if st and st != "All Statuses":
            data = [d for d in data
                    if d.get("status","").lower() == st.lower()]
        if self._sort_col:
            k = {"ID":"id","Title":"title","Priority":"priority",
                 "Status":"status","Assigned To":"assigned_to",
                 "Date":"date"}.get(self._sort_col,"id")
            data.sort(key=lambda d: d.get(k,""), reverse=self._sort_rev)

        t = self._vtree
        t.delete(*t.get_children())
        for d in data:
            pri = d.get("priority","")
            t.insert("", "end", iid=d.get("id",""), values=(
                d.get("id",""), d.get("title",""), pri,
                d.get("status",""), d.get("assigned_to",""), d.get("date","")
            ), tags=(pri,))

    def _delete_selected(self):
        sel = self._vtree.selection()
        if not sel:
            return
        if not messagebox.askyesno("Delete",
                f"Delete {len(sel)} defect(s)? This cannot be undone."):
            return
        ids = set(sel)
        self.defects = [d for d in self.defects if d.get("id") not in ids]
        save_defects(self.defects)
        self._refresh_view()
        self._refresh_dashboard()

    def _export_csv(self):
        path = filedialog.asksaveasfilename(
            defaultextension=".csv",
            filetypes=[("CSV files","*.csv")],
            initialfile="defects.csv")
        if not path:
            return
        with open(path, "w", newline="", encoding="utf-8") as f:
            w = csv.writer(f)
            w.writerow(["ID","Title","Priority","Status","Assigned To","Date"])
            for d in self.defects:
                w.writerow([d.get("id",""), d.get("title",""),
                            d.get("priority",""), d.get("status",""),
                            d.get("assigned_to",""), d.get("date","")])
        messagebox.showinfo("Export", f"Exported {len(self.defects)} records to:\n{path}")

