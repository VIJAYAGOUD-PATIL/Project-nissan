        strip = tk.Frame(card, bg=color, height=6)
        strip.pack(fill="x")

        body = tk.Frame(card, bg=SURFACE)
        body.pack(padx=28, pady=24, fill="both")

        # Icon circle
        ic = tk.Canvas(body, width=54, height=54, bg=SURFACE, highlightthickness=0)
        ic.pack(anchor="w", pady=(0, 16))
        ic.create_oval(2, 2, 52, 52, fill=color + "22", outline=color, width=2)
        ic.create_text(27, 27, text=icon, fill=color, font=("Segoe UI", 20))

        tk.Label(body, text=f"Project {name}", bg=SURFACE,
                 fg=TEXT_PRI, font=("Segoe UI", 16, "bold")).pack(anchor="w")
        tk.Label(body, text=desc, bg=SURFACE,
                 fg=TEXT_SEC, font=("Segoe UI", 10),
                 justify="left").pack(anchor="w", pady=(4, 16))

        # Mini stats
        stats = tk.Frame(body, bg="#f8f9fa",
