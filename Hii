        username = self._user_var.get().strip()
        password = self._pass_var.get()
        if username == _APP_USERNAME and password == _APP_PASSWORD:
            self.root.destroy()
            _launch_app()
        else:
            self._err_lbl.config(text="⚠  Invalid username or password.")
            self._pass_var.set("")
            self._pass_entry.focus()


