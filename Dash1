    var msg  = document.getElementById('_alStep1Msg');
    btn.disabled = true;
    btn.innerHTML = '<div class="_al-spinner"></div> Opening…';
    dot.className = '_al-status-dot running';
    msg.innerHTML = 'Opening <strong>' + AUTO_LOGIN_URL + '</strong>…';

    // Open the URL
    window.open(AUTO_LOGIN_URL, '_blank');

    setTimeout(function() {
      dot.className = '_al-status-dot done-dot';
      msg.innerHTML = '✓ URL opened successfully in a new tab';
      btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Opened';
      setTimeout(function() { setStep(2); }, 700);
    }, 1200);
  });

  // ── Step 2: Copy credentials ──
  document.getElementById('_alStep2Btn').addEventListener('click', function() {
    var btn = this;
    var dot = document.getElementById('_alDot2');
    var msg = document.getElementById('_alStep2Msg');
    btn.disabled = true;
    btn.innerHTML = '<div class="_al-spinner"></div> Copying…';
    dot.className = '_al-status-dot running';
    msg.innerHTML = 'Copying credentials to clipboard…';

    // Copy password to clipboard
    var toCopy = AUTO_LOGIN_PASS;
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(toCopy).then(function() {
        finishStep2(dot, msg, btn);
      }).catch(function() {
        fallbackCopy(toCopy);
        finishStep2(dot, msg, btn);
      });
    } else {
      fallbackCopy(toCopy);
      finishStep2(dot, msg, btn);
    }
  });

  function fallbackCopy(text) {
    var ta = document.createElement('textarea');
    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); } catch(e) {}
    document.body.removeChild(ta);
  }

  function finishStep2(dot, msg, btn) {
    setTimeout(function() {
      dot.className = '_al-status-dot done-dot';
      msg.innerHTML = '✓ Password copied to clipboard — paste it in the login form';
      btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Copied!';
      // Fill summary
      document.getElementById('_alSummary').innerHTML =
        '🌐 Opened: <strong>' + AUTO_LOGIN_URL + '</strong><br>' +
        '👤 Username: <strong>' + AUTO_LOGIN_USER + '</strong><br>' +
        '🔑 Password: <strong>Copied to clipboard</strong>';
      setTimeout(function() { setStep(3); }, 700);
    }, 1000);
  }

  // ── Back button ──
  document.getElementById('_alBackBtn').addEventListener('click', function() { setStep(1); });

  // ── Close buttons ──
  function closePopup() { var o = document.getElementById('_alPopupOverlay'); if(o) o.remove(); }
  document.getElementById('_alCloseBtn').addEventListener('click', closePopup);
  document.getElementById('_alCancelBtn1').addEventListener('click', closePopup);
  document.getElementById('_alDoneBtn').addEventListener('click', closePopup);

  // Close on backdrop
  overlay.addEventListener('click', function(ev) { if (ev.target === overlay) closePopup(); });
}

// ═══ FILTER TABLE ═══

function filterTable() {

  var search   = document.getElementById('searchInput').value.toLowerCase();

  var priority = document.getElementById('filterPriority').value;

  var status   = document.getElementById('filterStatus').value;

  document.querySelectorAll('#viewTableBody tr').forEach(function(row) {

    if (!row.cells || row.cells.length < 4) { row.style.display=''; return; }

    var title = row.cells[1].textContent.toLowerCase();

    var ok = title.includes(search) && (!priority||row.dataset.priority===priority) && (!status||row.dataset.status===status);

    row.style.display = ok ? '' : 'none';

  });

}

// ═══ PASSWORD STRENGTH ═══

function checkPassStrength() {

  var val=document.getElementById('newPass').value;

  var bar=document.getElementById('settingStrengthBar'), fill=document.getElementById('settingStrengthFill'), lbl=document.getElementById('settingStrengthLabel');

  if (!val){ bar.classList.remove('show'); return; }

  bar.classList.add('show');

  var score=0;

  if(val.length>=8)score++; if(/[A-Z]/.test(val))score++; if(/[0-9]/.test(val))score++; if(/[^A-Za-z0-9]/.test(val))score++;

  var levels=[{pct:'25%',color:'#ef4444',label:'Weak',lc:'#ef4444'},{pct:'50%',color:'#f59e0b',label:'Fair',lc:'#d97706'},{pct:'75%',color:'#eab308',label:'Good',lc:'#a16207'},{pct:'100%',color:'#22c55e',label:'Strong',lc:'#15803d'}];

  var lvl=levels[score-1]||levels[0];

  fill.style.width=lvl.pct; fill.style.background=lvl.color; lbl.textContent=lvl.label; lbl.style.color=lvl.lc;

}

// ═══ EXPORT CSV ═══

function exportCSV() {

  var rows=[['ID','Title','Priority','Status','Assigned To','Date']];

  document.querySelectorAll('#viewTableBody tr').forEach(function(row) {

    if(!row.cells||row.cells.length<4)return;

    rows.push(Array.from(row.querySelectorAll('td')).map(function(td){ return '"'+td.textContent.trim().replace(/"/g,'""')+'"'; }));

  });

  var csv=rows.map(function(r){return r.join(',');}).join('\n');

  var a=document.createElement('a'); a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv); a.download='defects.csv'; a.click();

  showToast('info','Export complete','Defects downloaded as defects.csv');

}

