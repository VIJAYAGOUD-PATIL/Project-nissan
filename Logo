    def _page_modify(self):
        self._topbar("Modify Defect",
                     f"Edit an existing defect in Project {self.project.upper()}")
        scroll_outer = tk.Frame(self._main, bg=BG)
        scroll_outer.grid(row=1, column=0, sticky="nsew")
        scroll_outer.columnconfigure(0, weight=1)
        scroll_outer.rowconfigure(0, weight=1)

        canvas = tk.Canvas(scroll_outer, bg=BG, highlightthickness=0)
        vsb = ttk.Scrollbar(scroll_outer, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=vsb.set)
        canvas.grid(row=0, column=0, sticky="nsew")
        vsb.grid(row=0, column=1, sticky="ns")
        inner = tk.Frame(canvas, bg=BG)
        wid = canvas.create_window((0, 0), window=inner, anchor="nw")
        inner.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<Configure>", lambda e: canvas.itemconfig(wid, width=e.width))
        canvas.bind("<MouseWheel>", lambda e: canvas.yview_scroll(-1*(e.delta//120), "units"))
        canvas.bind("<Button-4>", lambda e: canvas.yview_scroll(-1, "units"))
        canvas.bind("<Button-5>", lambda e: canvas.yview_scroll(1, "units"))

        defects = self._proj_defects()

        if not defects:
            empty = tk.Frame(inner, bg=SURFACE,
                             highlightbackground=BORDER, highlightthickness=1)
            empty.pack(padx=36, pady=40, fill="both", expand=True)
            tk.Label(empty, text="📭  No Defects Yet",
                     bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 18, "bold")).pack(pady=(60, 8))
            tk.Label(empty, text="Create your first defect using the 'Create Defect' tab.",
                     bg=SURFACE, fg=TEXT_SEC,
                     font=("Segoe UI", 12)).pack(pady=(0, 60))
            return

        # Selector card
        sel_card = tk.Frame(inner, bg=SURFACE,
                            highlightbackground=BORDER, highlightthickness=1)
        sel_card.pack(padx=36, pady=(30, 16), fill="x")
        sel_hdr = tk.Frame(sel_card, bg=self._color)
        sel_hdr.pack(fill="x")
        tk.Label(sel_hdr, text="  ✎  Select Defect to Edit",
                 bg=self._color, fg="#fff",
                 font=("Segoe UI", 12, "bold")).pack(side="left", padx=16, pady=10)
        sel_body = tk.Frame(sel_card, bg=SURFACE)
        sel_body.pack(padx=30, pady=22, fill="x")
        choices = [f"#{d['id']}  —  {d['title']}" for d in defects]
        sel_var = tk.StringVar(value=choices[0])
        ttk.Combobox(sel_body, textvariable=sel_var, values=choices,
                     state="readonly", font=("Segoe UI", 11),
                     width=70).pack(fill="x", ipady=7)

        edit_wrap = tk.Frame(inner, bg=BG)
        edit_wrap.pack(fill="x", padx=36, pady=(0, 30))

        def load(*_):
            for w in edit_wrap.winfo_children():
                w.destroy()
            idx = choices.index(sel_var.get())
            d   = defects[idx]

            ecard = tk.Frame(edit_wrap, bg=SURFACE,
                             highlightbackground=BORDER, highlightthickness=1)
            ecard.pack(fill="x")
            ehdr = tk.Frame(ecard, bg=SIDEBAR2)
            ehdr.pack(fill="x")
            tk.Label(ehdr, text=f"  Editing Defect #{d.get('id','')}  —  {d.get('title','')}",
                     bg=SIDEBAR2, fg="#c9d3e0",
                     font=("Segoe UI", 11, "bold")).pack(side="left", padx=16, pady=10)

            ebody = tk.Frame(ecard, bg=SURFACE)
            ebody.pack(padx=32, pady=26, fill="x")
            ebody.columnconfigure(0, weight=1)
            ebody.columnconfigure(1, weight=1)

            tk.Label(ebody, text="Title *", bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).grid(row=0, column=0, columnspan=2,
                                                          sticky="w", pady=(0, 5))
            t_var = tk.StringVar(value=d.get("title", ""))
            styled_entry(ebody, textvariable=t_var, width=80).grid(row=1, column=0, columnspan=2,
                                                                     sticky="ew", ipady=8, pady=(0, 18))

            tk.Label(ebody, text="Description", bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).grid(row=2, column=0, columnspan=2,
                                                          sticky="w", pady=(0, 5))
            dtxt = tk.Text(ebody, height=4, bg="#f9fafb", fg=TEXT_PRI,
                           font=("Segoe UI", 11), relief="flat",
                           highlightbackground=BORDER, highlightthickness=1)
            dtxt.insert("1.0", d.get("description", ""))
            dtxt.grid(row=3, column=0, columnspan=2, sticky="ew", pady=(0, 18))

            p_frame = tk.Frame(ebody, bg=SURFACE)
            p_frame.grid(row=4, column=0, sticky="ew", padx=(0, 12), pady=(0, 18))
            tk.Label(p_frame, text="Priority", bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0, 5))
            p_var = tk.StringVar(value=d.get("priority", "Minor"))
            ttk.Combobox(p_frame, textvariable=p_var,
                         values=["Critical", "Major", "Minor", "Low"],
                         state="readonly", font=("Segoe UI", 11)).pack(fill="x", ipady=6)

            s_frame = tk.Frame(ebody, bg=SURFACE)
            s_frame.grid(row=4, column=1, sticky="ew", padx=(12, 0), pady=(0, 18))
            tk.Label(s_frame, text="Status", bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0, 5))
            s_var = tk.StringVar(value=d.get("status", "Open"))
            ttk.Combobox(s_frame, textvariable=s_var,
                         values=["Open", "In Progress", "Closed", "Resolved"],
                         state="readonly", font=("Segoe UI", 11)).pack(fill="x", ipady=6)

            tk.Label(ebody, text="Assignee", bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).grid(row=5, column=0, columnspan=2,
                                                          sticky="w", pady=(0, 5))
            a_var = tk.StringVar(value=d.get("assignee", ""))
            styled_entry(ebody, textvariable=a_var).grid(row=6, column=0, columnspan=2,
                                                          sticky="ew", ipady=8, pady=(0, 24))

            tk.Frame(ebody, bg=BORDER, height=1).grid(row=7, column=0, columnspan=2,
                                                       sticky="ew", pady=(0, 18))

            def do_save():
                title = t_var.get().strip()
                if not title:
                    messagebox.showerror("Validation", "Title is required.")
                    return
                d["title"]       = title
                d["description"] = dtxt.get("1.0", "end").strip()
                d["priority"]    = p_var.get()
                d["status"]      = s_var.get()
                d["assignee"]    = a_var.get().strip()
                save_data(APP_DATA)
                messagebox.showinfo("Saved", f"✔  Defect #{d['id']} updated successfully!")

            sb = tk.Button(ebody, text="  ✔  Save Changes",
                           bg=self._color, fg="#fff",
                           font=("Segoe UI", 12, "bold"), relief="flat", cursor="hand2",
                           activebackground=BRAND_DARK, padx=24, pady=12, command=do_save)
            sb.grid(row=8, column=0, sticky="w")
            sb.bind("<Enter>", lambda e: sb.config(bg=BRAND_DARK))
            sb.bind("<Leave>", lambda e: sb.config(bg=self._color))

        sel_var.trace_add("write", load)
        load()

