            self.root.state("zoomed")          # Windows maximise
        except Exception:
            pass

        self.defects = load_defects()
        self._sort_col, self._sort_rev = None, False
        self._attachments = []

        self._setup_styles()

        # Root grid: row 0 = navbar, row 1 = body; col 0 = sidebar, col 1 = main
        self.root.rowconfigure(0, weight=0)
        self.root.rowconfigure(1, weight=1)
        self.root.columnconfigure(0, weight=0)
        self.root.columnconfigure(1, weight=1)

        self._build_navbar()
        self._build_sidebar()
        self._build_main()

