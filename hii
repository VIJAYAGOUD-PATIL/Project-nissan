        tk.Frame(root, bg="#2d3f5a", width=1).grid(row=0, column=0,
            sticky="nse", padx=(0, 0))

        # ── Right login form ───────────────────────────────────────────
        right = tk.Frame(root, bg="#131f30")
        right.grid(row=0, column=1, sticky="nsew")

        form = tk.Frame(right, bg="#131f30")
        form.place(relx=0.5, rely=0.5, anchor="center")

        tk.Label(form, text="Welcome back",
                 bg="#131f30", fg="#ffffff",
                 font=("Segoe UI", 26, "bold")).pack(anchor="w")
        tk.Label(form, text="Sign in to your account",
                 bg="#131f30", fg=TEXT_SEC,
                 font=("Segoe UI", 12)).pack(anchor="w", pady=(4, 30))

        # Username
        tk.Label(form, text="Username", bg="#131f30", fg="#c9d3e0",
                 font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0, 6))
        self._user = RoundedEntry(form, placeholder="Enter username", width=340)
        self._user.pack(fill="x", pady=(0, 18))

        # Password
        tk.Label(form, text="Password", bg="#131f30", fg="#c9d3e0",
                 font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0, 6))
        self._pwd = RoundedEntry(form, show="●", placeholder="Enter password", width=340)
        self._pwd.pack(fill="x", pady=(0, 10))

        # Hint
        tk.Label(form, text="Default: admin / admin123",
                 bg="#131f30", fg=TEXT_MUT,
                 font=("Segoe UI", 9)).pack(anchor="e", pady=(0, 24))

