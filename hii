        root.columnconfigure(0, weight=1)
        root.columnconfigure(1, weight=1)
        root.rowconfigure(0, weight=1)

        # ── Left decorative panel ──────────────────────────────────────
        left = tk.Frame(root, bg=SIDEBAR_BG)
        left.grid(row=0, column=0, sticky="nsew")
        left.columnconfigure(0, weight=1)
        left.rowconfigure(0, weight=1)

        inner_left = tk.Frame(left, bg=SIDEBAR_BG)
        inner_left.place(relx=0.5, rely=0.5, anchor="center")

        # Logo circle
        canvas = tk.Canvas(inner_left, width=90, height=90,
                            bg=SIDEBAR_BG, highlightthickness=0)
        canvas.pack(pady=(0, 20))
        canvas.create_oval(5, 5, 85, 85, fill=BRAND, outline="")
        canvas.create_text(45, 45, text="DT", fill="white",
                           font=("Segoe UI", 26, "bold"))

        tk.Label(inner_left, text="Defect Tracker",
                 bg=SIDEBAR_BG, fg="#ffffff",
                 font=("Segoe UI", 28, "bold")).pack()
        tk.Label(inner_left, text="Track. Fix. Ship.",
                 bg=SIDEBAR_BG, fg=TEXT_SEC,
                 font=("Segoe UI", 13)).pack(pady=(6, 40))

        # Feature pills
        for icon, txt in [("✓", "Multi-project support"),
                           ("✓", "Real-time defect tracking"),
                           ("✓", "Priority management")]:
            row = tk.Frame(inner_left, bg=SIDEBAR2,
                           highlightbackground="#2d3f5a",
                           highlightthickness=1)
            row.pack(fill="x", pady=5, ipady=8, ipadx=14)
            tk.Label(row, text=icon, bg=SIDEBAR2,
                     fg=BRAND, font=("Segoe UI", 13, "bold")).pack(side="left", padx=(10, 8))
            tk.Label(row, text=txt, bg=SIDEBAR2,
                     fg="#c9d3e0", font=("Segoe UI", 11)).pack(side="left")

