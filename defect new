# ══════════════════════════════════════════════════════════════════════════════
class DashboardWindow:
    def __init__(self, root: tk.Tk, project: str):
        self.root    = root
        self.project = project
        root.title(f"Defect Tracker — {project}")
        root.configure(bg=BG)
        root.resizable(True, True)
        zoomed(root)
        self._active = None
        self._nav_btns = {}
        self._build_shell()
        self._switch("create")

    # ── Shell: sidebar + main area ─────────────────────────────────────
    def _build_shell(self):
        r = self.root
        r.columnconfigure(1, weight=1)
        r.rowconfigure(0, weight=1)

        # Sidebar
        self._sb = tk.Frame(r, bg=SIDEBAR_BG, width=230)
        self._sb.grid(row=0, column=0, sticky="nsew")
        self._sb.pack_propagate(False)
        self._build_sidebar()

        # Main
        self._main = tk.Frame(r, bg=BG)
        self._main.grid(row=0, column=1, sticky="nsew")
        self._main.columnconfigure(0, weight=1)
        self._main.rowconfigure(0, weight=1)

    def _build_sidebar(self):
        sb = self._sb

        # Logo
        lf = tk.Frame(sb, bg=SIDEBAR_BG)
        lf.pack(fill="x", padx=18, pady=(22, 6))
        lc = tk.Canvas(lf, width=32, height=32, bg=SIDEBAR_BG, highlightthickness=0)
        lc.pack(side="left")
        lc.create_oval(2, 2, 30, 30, fill=BRAND, outline="")
        lc.create_text(16, 16, text="DT", fill="white", font=("Segoe UI", 10, "bold"))
        tk.Label(lf, text="  Defect Tracker",
                 bg=SIDEBAR_BG, fg="#fff",
                 font=("Segoe UI", 12, "bold")).pack(side="left")

        # Project pill
        pp = tk.Frame(sb, bg=BRAND + "22",
                      highlightbackground=BRAND, highlightthickness=1)
        pp.pack(fill="x", padx=18, pady=(14, 20), ipady=8)
        tk.Label(pp, text=f"◈  Project  {self.project}",
                 bg=BRAND + "22", fg=BRAND,
                 font=("Segoe UI", 11, "bold")).pack()

        tk.Frame(sb, bg="#2d3f5a", height=1).pack(fill="x", padx=18, pady=(0, 14))

        # Nav items
        items = [
            ("create",  "＋  Create Defect"),
            ("modify",  "✎   Modify Defect"),
            ("view",    "≡   View Defects"),
            ("results", "◎  View Results"),
        ]
        for key, label in items:
            btn = tk.Button(sb, text=label,
                            bg=SIDEBAR_BG, fg="#c9d3e0",
                            font=("Segoe UI", 11), relief="flat",
                            anchor="w", padx=20, pady=11,
                            cursor="hand2",
                            activebackground=SIDEBAR2, activeforeground="#fff",
                            command=lambda k=key: self._switch(k))
            btn.pack(fill="x", padx=8, pady=2)
            btn.bind("<Enter>", lambda e, b=btn: b.config(bg=SIDEBAR2)
                     if b.cget("bg") != BRAND else None)
            btn.bind("<Leave>", lambda e, b=btn: b.config(bg=SIDEBAR_BG)
                     if b.cget("bg") != BRAND else None)
            self._nav_btns[key] = btn

        # Spacer
        tk.Frame(sb, bg=SIDEBAR_BG).pack(fill="both", expand=True)

        tk.Frame(sb, bg="#2d3f5a", height=1).pack(fill="x", padx=18, pady=(0, 8))

        tk.Button(sb, text="← Back to Projects",
                  bg=SIDEBAR_BG, fg=TEXT_SEC,
                  font=("Segoe UI", 10), relief="flat",
                  anchor="w", padx=20, pady=8, cursor="hand2",
                  command=self._go_back).pack(fill="x", padx=8, pady=2)

        tk.Button(sb, text="⏻  Logout",
                  bg=SIDEBAR_BG, fg=TEXT_SEC,
                  font=("Segoe UI", 10), relief="flat",
                  anchor="w", padx=20, pady=8, cursor="hand2",
                  command=self._logout).pack(fill="x", padx=8, pady=(2, 16))

    def _switch(self, key):
        # Highlight active nav
        for k, b in self._nav_btns.items():
            b.config(bg=BRAND if k == key else SIDEBAR_BG,
                     fg="#ffffff")

        # Clear main area
        for w in self._main.winfo_children():
            w.destroy()

        self._active = key
        if key == "create":
            self._page_create()
        elif key == "modify":
            self._page_modify()
        elif key == "view":
            self._page_view()
        elif key == "results":
            self._page_results()

    # ── Top bar ────────────────────────────────────────────────────────
    def _topbar(self, title, sub=""):
        bar = tk.Frame(self._main, bg=SURFACE,
                       highlightbackground=BORDER, highlightthickness=1)
        bar.pack(fill="x")
        inner = tk.Frame(bar, bg=SURFACE)
        inner.pack(fill="x", padx=28, pady=16)
        tk.Label(inner, text=title, bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 18, "bold")).pack(anchor="w")
        if sub:
            tk.Label(inner, text=sub, bg=SURFACE, fg=TEXT_SEC,
                     font=("Segoe UI", 10)).pack(anchor="w", pady=(2, 0))

    def _proj_defects(self):
        return [d for d in ALL_DEFECTS if d.get("project") == self.project]

    # ════════════════════════════════════════════════════════════════════
    #  CREATE DEFECT
    # ════════════════════════════════════════════════════════════════════
    def _page_create(self):
        self._topbar("Create Defect",
                     f"Log a new defect for Project {self.project}")

        scroll = scrollable_frame(self._main)

        card = tk.Frame(scroll, bg=SURFACE,
                        highlightbackground=BORDER, highlightthickness=1)
        card.pack(padx=32, pady=24, fill="x")

        body = tk.Frame(card, bg=SURFACE)
        body.pack(padx=30, pady=28, fill="x")

        # Title
        tk.Label(body, text="Title *", bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0, 5))
        title_var = tk.StringVar()
        e = styled_entry(body, textvariable=title_var)
        e.pack(fill="x", ipady=7)

        # Description
        tk.Label(body, text="Description", bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(18, 5))
        desc_box = tk.Text(body, height=4, bg="#f9fafb", fg=TEXT_PRI,
                           font=("Segoe UI", 11), relief="flat",
                           highlightbackground=BORDER, highlightthickness=1)
        desc_box.pack(fill="x")

        # Priority + Status
        row2 = tk.Frame(body, bg=SURFACE)
        row2.pack(fill="x", pady=(18, 0))
        row2.columnconfigure(0, weight=1)
        row2.columnconfigure(1, weight=1)

        pri_var = tk.StringVar(value="Minor")
        sta_var = tk.StringVar(value="Open")

        for col, lbl, var, opts in [
            (0, "Priority", pri_var, ["Critical", "Major", "Minor", "Low"]),
            (1, "Status",   sta_var, ["Open", "In Progress", "Closed", "Resolved"]),
        ]:
            f = tk.Frame(row2, bg=SURFACE)
            f.grid(row=0, column=col,
                   padx=(0, 0) if col == 0 else (14, 0), sticky="ew")
            tk.Label(f, text=lbl, bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0, 5))
            cb = ttk.Combobox(f, textvariable=var, values=opts,
                              state="readonly", font=("Segoe UI", 11))
            cb.pack(fill="x", ipady=6)

        # Assignee
        tk.Label(body, text="Assignee", bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(18, 5))
        assign_var = tk.StringVar()
        styled_entry(body, textvariable=assign_var).pack(fill="x", ipady=7)

        # Submit button
        def do_create():
            t = title_var.get().strip()
            if not t:
                messagebox.showerror("Validation", "Title is required.")
                return
            new_id = max((d.get("id", 0) for d in ALL_DEFECTS), default=0) + 1
            ALL_DEFECTS.append({
                "id":          new_id,
                "project":     self.project,
                "title":       t,
                "description": desc_box.get("1.0", "end").strip(),
                "priority":    pri_var.get(),
                "status":      sta_var.get(),
                "assignee":    assign_var.get().strip(),
                "created":     datetime.date.today().strftime("%d %b %Y"),
            })
            save_defects(ALL_DEFECTS)
            messagebox.showinfo("Created", f"Defect #{new_id} created successfully!")
            title_var.set("")
            desc_box.delete("1.0", "end")
            assign_var.set("")
            pri_var.set("Minor")
            sta_var.set("Open")

        btn = tk.Button(body, text="Create Defect",
                        bg=BRAND, fg="#fff",
                        font=("Segoe UI", 12, "bold"),
                        relief="flat", cursor="hand2",
                        activebackground=BRAND_DARK,
                        pady=12, command=do_create)
        btn.pack(fill="x", pady=(26, 0))
        btn.bind("<Enter>", lambda e: btn.config(bg=BRAND_DARK))
        btn.bind("<Leave>", lambda e: btn.config(bg=BRAND))

    # ════════════════════════════════════════════════════════════════════
    #  MODIFY DEFECT
    # ════════════════════════════════════════════════════════════════════
    def _page_modify(self):
        self._topbar("Modify Defect",
                     f"Edit an existing defect in Project {self.project}")

        scroll = scrollable_frame(self._main)
        defects = self._proj_defects()

        if not defects:
            tk.Label(scroll, text="No defects found. Create one first!",
                     bg=BG, fg=TEXT_SEC,
                     font=("Segoe UI", 13)).pack(pady=70)
            return

        # ── Selector card ──────────────────────────────────────────────
        sel_card = tk.Frame(scroll, bg=SURFACE,
                            highlightbackground=BORDER, highlightthickness=1)
        sel_card.pack(padx=32, pady=(24, 16), fill="x")
        sel_body = tk.Frame(sel_card, bg=SURFACE)
        sel_body.pack(padx=30, pady=22, fill="x")

        tk.Label(sel_body, text="Select Defect",
                 bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 13, "bold")).pack(anchor="w", pady=(0, 10))

        choices = [f"#{d['id']}  —  {d['title']}" for d in defects]
        sel_var = tk.StringVar(value=choices[0])
        sel_cb  = ttk.Combobox(sel_body, textvariable=sel_var,
                               values=choices, state="readonly",
                               font=("Segoe UI", 11), width=60)
        sel_cb.pack(fill="x", ipady=7)

        # ── Edit form (rebuilt on selection change) ────────────────────
        edit_wrap = tk.Frame(scroll, bg=BG)
        edit_wrap.pack(fill="x", padx=32, pady=(0, 28))

        def load(*args):
            for w in edit_wrap.winfo_children():
                w.destroy()

            idx = choices.index(sel_var.get())
            d   = defects[idx]

            ecard = tk.Frame(edit_wrap, bg=SURFACE,
                             highlightbackground=BORDER, highlightthickness=1)
            ecard.pack(fill="x")
            ebody = tk.Frame(ecard, bg=SURFACE)
            ebody.pack(padx=30, pady=26, fill="x")

            # Title
            tk.Label(ebody, text="Title *", bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0, 5))
            t_var = tk.StringVar(value=d.get("title", ""))
            styled_entry(ebody, textvariable=t_var).pack(fill="x", ipady=7)

            # Description
            tk.Label(ebody, text="Description", bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(18, 5))
            dtxt = tk.Text(ebody, height=4, bg="#f9fafb", fg=TEXT_PRI,
                           font=("Segoe UI", 11), relief="flat",
                           highlightbackground=BORDER, highlightthickness=1)
            dtxt.insert("1.0", d.get("description", ""))
            dtxt.pack(fill="x")

            # Priority + Status
            row2 = tk.Frame(ebody, bg=SURFACE)
            row2.pack(fill="x", pady=(18, 0))
            row2.columnconfigure(0, weight=1)
            row2.columnconfigure(1, weight=1)

            p_var = tk.StringVar(value=d.get("priority", "Minor"))
            s_var = tk.StringVar(value=d.get("status",   "Open"))

            for col, lbl, var, opts in [
                (0, "Priority", p_var, ["Critical", "Major", "Minor", "Low"]),
                (1, "Status",   s_var, ["Open", "In Progress", "Closed", "Resolved"]),
            ]:
                f = tk.Frame(row2, bg=SURFACE)
                f.grid(row=0, column=col,
                       padx=(0, 0) if col == 0 else (14, 0), sticky="ew")
                tk.Label(f, text=lbl, bg=SURFACE, fg=TEXT_PRI,
                         font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0, 5))
                cb = ttk.Combobox(f, textvariable=var, values=opts,
                                  state="readonly", font=("Segoe UI", 11))
                cb.pack(fill="x", ipady=6)

            # Assignee
            tk.Label(ebody, text="Assignee", bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(18, 5))
            a_var = tk.StringVar(value=d.get("assignee", ""))
            styled_entry(ebody, textvariable=a_var).pack(fill="x", ipady=7)

            def do_save():
                title = t_var.get().strip()
                if not title:
                    messagebox.showerror("Validation", "Title is required.")
                    return
                d["title"]       = title
                d["description"] = dtxt.get("1.0", "end").strip()
                d["priority"]    = p_var.get()
                d["status"]      = s_var.get()
                d["assignee"]    = a_var.get().strip()
                save_defects(ALL_DEFECTS)
                messagebox.showinfo("Saved", f"Defect #{d['id']} updated!")

            sb_btn = tk.Button(ebody, text="Save Changes",
                               bg=BRAND, fg="#fff",
                               font=("Segoe UI", 12, "bold"),
                               relief="flat", cursor="hand2",
                               activebackground=BRAND_DARK,
                               pady=12, command=do_save)
            sb_btn.pack(fill="x", pady=(26, 0))
            sb_btn.bind("<Enter>", lambda e: sb_btn.config(bg=BRAND_DARK))
            sb_btn.bind("<Leave>", lambda e: sb_btn.config(bg=BRAND))

        sel_var.trace_add("write", load)
        load()

    # ════════════════════════════════════════════════════════════════════
    #  VIEW DEFECTS
    # ════════════════════════════════════════════════════════════════════
    def _page_view(self):
        defects = self._proj_defects()
        self._topbar("View Defects",
                     f"{len(defects)} defect(s) in Project {self.project}")

        scroll = scrollable_frame(self._main)

        if not defects:
            tk.Label(scroll, text="No defects yet. Create one!",
                     bg=BG, fg=TEXT_SEC,
                     font=("Segoe UI", 13)).pack(pady=70)
            return

        # Column header
        hdr = tk.Frame(scroll, bg="#e4e6ea")
        hdr.pack(fill="x", padx=28, pady=(20, 0))
        for txt, w in [("#", 5), ("Title", 32), ("Priority", 10),
                       ("Status", 12), ("Assignee", 14), ("Created", 14)]:
            tk.Label(hdr, text=txt, bg="#e4e6ea", fg=TEXT_SEC,
                     font=("Segoe UI", 10, "bold"),
                     width=w, anchor="w" if txt == "Title" else "center"
                     ).pack(side="left", padx=6, pady=8)

        PRI_COLOR = {"Critical": RED_C,  "Major": ORANGE,
                     "Minor":    BLUE,   "Low":   GREEN}
        STA_COLOR = {"Open":        RED_C,  "In Progress": ORANGE,
                     "Closed":      GREEN,  "Resolved":    BLUE}

        for d in reversed(defects):
            row = tk.Frame(scroll, bg=SURFACE,
                           highlightbackground=BORDER, highlightthickness=1)
            row.pack(fill="x", padx=28, pady=4)

            inner = tk.Frame(row, bg=SURFACE)
            inner.pack(fill="x", padx=10, pady=9)

            pri = d.get("priority", "Minor")
            sta = d.get("status",   "Open")
            pc  = PRI_COLOR.get(pri, TEXT_SEC)
            sc  = STA_COLOR.get(sta, TEXT_SEC)

            tk.Label(inner, text=f"#{d.get('id','?')}",
                     bg=SURFACE, fg=TEXT_MUT,
                     font=("Segoe UI", 10), width=5,
                     anchor="center").pack(side="left", padx=4)

            tk.Label(inner, text=d.get("title", ""),
                     bg=SURFACE, fg=TEXT_PRI,
                     font=("Segoe UI", 11), width=32,
                     anchor="w").pack(side="left", padx=8)

            for val, col, w in [(pri, pc, 10), (sta, sc, 12)]:
                tk.Label(inner, text=val,
                         bg=col + "18", fg=col,
                         font=("Segoe UI", 9, "bold"),
                         padx=8, pady=3, width=w,
                         anchor="center").pack(side="left", padx=5)

            tk.Label(inner, text=d.get("assignee", "—"),
                     bg=SURFACE, fg=TEXT_SEC,
                     font=("Segoe UI", 10), width=14,
                     anchor="center").pack(side="left", padx=5)

            tk.Label(inner, text=d.get("created", ""),
                     bg=SURFACE, fg=TEXT_MUT,
                     font=("Segoe UI", 10), width=14,
                     anchor="center").pack(side="left", padx=5)

    # ════════════════════════════════════════════════════════════════════
    #  VIEW RESULTS
    # ════════════════════════════════════════════════════════════════════
    def _page_results(self):
        defects = self._proj_defects()
        self._topbar("View Results",
                     f"Defect analytics for Project {self.project}")

        scroll = scrollable_frame(self._main)

        total   = len(defects)
        open_c  = sum(1 for d in defects if d.get("status") == "Open")
        prog_c  = sum(1 for d in defects if d.get("status") == "In Progress")
        closed_c= sum(1 for d in defects if d.get("status") in ("Closed", "Resolved"))

        # ── Summary stat cards ─────────────────────────────────────────
        stat_row = tk.Frame(scroll, bg=BG)
        stat_row.pack(fill="x", padx=28, pady=(24, 20))

        for lbl, val, color in [
            ("Total Defects",  total,    TEXT_PRI),
            ("Open",           open_c,   RED_C),
            ("In Progress",    prog_c,   ORANGE),
            ("Closed",         closed_c, GREEN),
        ]:
            sc = tk.Frame(stat_row, bg=SURFACE,
                          highlightbackground=BORDER, highlightthickness=1)
            sc.pack(side="left", expand=True, fill="x",
                    padx=6, ipadx=12, ipady=16)
            tk.Label(sc, text=str(val),
                     bg=SURFACE, fg=color,
                     font=("Segoe UI", 26, "bold")).pack()
            tk.Label(sc, text=lbl,
                     bg=SURFACE, fg=TEXT_SEC,
                     font=("Segoe UI", 10)).pack(pady=(2, 0))

        # ── Bar chart panels ───────────────────────────────────────────
        tk.Frame(scroll, bg=BORDER, height=1).pack(fill="x", padx=28, pady=(8, 20))

        two = tk.Frame(scroll, bg=BG)
        two.pack(fill="x", padx=28, pady=(0, 24))
        two.columnconfigure(0, weight=1)
        two.columnconfigure(1, weight=1)

        self._bar_card(two, 0, "Priority Breakdown", [
            ("Critical", sum(1 for d in defects if d.get("priority") == "Critical"), RED_C),
            ("Major",    sum(1 for d in defects if d.get("priority") == "Major"),    ORANGE),
            ("Minor",    sum(1 for d in defects if d.get("priority") == "Minor"),    BLUE),
            ("Low",      sum(1 for d in defects if d.get("priority") == "Low"),      GREEN),
        ], total or 1)

        self._bar_card(two, 1, "Status Breakdown", [
            ("Open",        open_c,   RED_C),
            ("In Progress", prog_c,   ORANGE),
            ("Closed",      sum(1 for d in defects if d.get("status") == "Closed"),   GREEN),
            ("Resolved",    sum(1 for d in defects if d.get("status") == "Resolved"), BLUE),
        ], total or 1)

        # ── Recent defects table ───────────────────────────────────────
        tk.Frame(scroll, bg=BORDER, height=1).pack(fill="x", padx=28, pady=(0, 20))

        tbl_card = tk.Frame(scroll, bg=SURFACE,
                            highlightbackground=BORDER, highlightthickness=1)
        tbl_card.pack(fill="x", padx=28, pady=(0, 28))

        tk.Label(tbl_card, text="All Defects",
                 bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 13, "bold")).pack(anchor="w", padx=22, pady=(16, 8))

        cols = ("ID", "Title", "Priority", "Status", "Assignee", "Created")
        style = ttk.Style()
        style.configure("Treeview",        font=("Segoe UI", 10), rowheight=32)
        style.configure("Treeview.Heading",font=("Segoe UI", 10, "bold"))
        style.map("Treeview", background=[("selected", BRAND + "33")])

        tree = ttk.Treeview(tbl_card, columns=cols,
                             show="headings", height=min(len(defects), 12))
        for col, w in zip(cols, [50, 260, 90, 110, 120, 110]):
            tree.heading(col, text=col)
            tree.column(col, width=w,
                         anchor="w" if col == "Title" else "center")
        tree.pack(fill="x", padx=20, pady=(0, 20))

        for d in reversed(defects):
            tree.insert("", "end", values=(
                f"#{d.get('id','?')}",
                d.get("title", ""),
                d.get("priority", ""),
                d.get("status", ""),
                d.get("assignee", "—"),
                d.get("created", ""),
            ))

    def _bar_card(self, parent, col, title, items, total):
        card = tk.Frame(parent, bg=SURFACE,
                        highlightbackground=BORDER, highlightthickness=1)
        card.grid(row=0, column=col,
                  padx=(0, 0) if col == 0 else (14, 0), sticky="nsew")

        body = tk.Frame(card, bg=SURFACE)
        body.pack(padx=22, pady=20, fill="x")

        tk.Label(body, text=title, bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 12, "bold")).pack(anchor="w", pady=(0, 14))

        for lbl, count, color in items:
            row = tk.Frame(body, bg=SURFACE)
            row.pack(fill="x", pady=5)

            tk.Label(row, text=lbl, bg=SURFACE, fg=TEXT_SEC,
                     font=("Segoe UI", 10), width=12,
                     anchor="w").pack(side="left")

            track = tk.Frame(row, bg="#f0f2f5", height=12)
            track.pack(side="left", fill="x", expand=True, padx=(8, 8))
            track.pack_propagate(False)

            pct = count / total
            if pct > 0:
                fill = tk.Frame(track, bg=color, height=12)
                fill.place(relx=0, rely=0, relwidth=pct, relheight=1)

            tk.Label(row, text=str(count), bg=SURFACE, fg=color,
                     font=("Segoe UI", 10, "bold"),
                     width=3, anchor="e").pack(side="right")

    # ── Navigation ─────────────────────────────────────────────────────
    def _go_back(self):
        self.root.destroy()
        r = tk.Tk()
        ProjectPage(r)
        r.mainloop()

