    def _show_add_dialog(self):
        dlg = tk.Toplevel(self.root)
        dlg.title("Add New Project")
        dlg.configure(bg=SURFACE)
        dlg.resizable(False, False)
        dlg.geometry("440x400")
        dlg.grab_set()
        dlg.update_idletasks()
        x = self.root.winfo_x() + (self.root.winfo_width()  - 440) // 2
        y = self.root.winfo_y() + (self.root.winfo_height() - 400) // 2
        dlg.geometry(f"440x400+{x}+{y}")

        tk.Frame(dlg, bg=BRAND, height=5).pack(fill="x")
        body = tk.Frame(dlg, bg=SURFACE)
        body.pack(padx=32, pady=28, fill="both", expand=True)

        tk.Label(body, text="Create New Project",
                 bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 16, "bold")).pack(anchor="w")
        tk.Label(body, text="Add a new project to your workspace",
                 bg=SURFACE, fg=TEXT_SEC,
                 font=("Segoe UI", 10)).pack(anchor="w", pady=(4, 24))

        tk.Label(body, text="Project Name *",
                 bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0, 5))
        name_var = tk.StringVar()
        styled_entry(body, textvariable=name_var, width=40).pack(fill="x", ipady=7)

        tk.Label(body, text="Description",
                 bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(16, 5))
        desc_box = tk.Text(body, height=3, bg="#f9fafb", fg=TEXT_PRI,
                           font=("Segoe UI", 11), relief="flat",
                           highlightbackground=BORDER, highlightthickness=1)
        desc_box.pack(fill="x")

        tk.Label(body, text="Accent Color",
                 bg=SURFACE, fg=TEXT_PRI,
                 font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(16, 8))
        color_var = tk.StringVar(value=BRAND)
        color_row = tk.Frame(body, bg=SURFACE)
        color_row.pack(anchor="w")
        palette = [BRAND, BLUE, PURPLE, GREEN, ORANGE, "#0891b2"]
        btn_refs = []

        def pick(c):
            color_var.set(c)
            for b in btn_refs:
                b.config(relief="sunken" if b.cget("bg") == c else "flat",
                         bd=3 if b.cget("bg") == c else 1)

        for col in palette:
            cb = tk.Button(color_row, bg=col, width=3, height=1,
                           relief="flat", bd=1, cursor="hand2",
                           command=lambda c=col: pick(c))
            cb.pack(side="left", padx=4)
            btn_refs.append(cb)
        btn_refs[0].config(relief="sunken", bd=3)

        def do_create():
            n = name_var.get().strip()
            if not n:
                messagebox.showerror("Validation", "Project name is required.", parent=dlg)
                return
            if n.lower() in [p["name"].lower() for p in APP_DATA["projects"]]:
                messagebox.showerror("Duplicate", f'Project "{n}" already exists.', parent=dlg)
                return
            raw_desc = desc_box.get("1.0", "end").strip()
            APP_DATA["projects"].append({
                "name":  n,
                "color": color_var.get(),
                "icon":  "◇",
                "desc":  raw_desc or "Custom project",
            })
            save_data(APP_DATA)
            dlg.destroy()
            self._render_cards()

        btn_row = tk.Frame(body, bg=SURFACE)
        btn_row.pack(fill="x", pady=(20, 0))
        create_btn = tk.Button(btn_row, text="Create Project",
                               bg=BRAND, fg="#fff",
                               font=("Segoe UI", 11, "bold"),
                               relief="flat", cursor="hand2",
                               padx=20, pady=9, command=do_create)
        create_btn.pack(side="left")
        create_btn.bind("<Enter>", lambda e: create_btn.config(bg=BRAND_DARK))
        create_btn.bind("<Leave>", lambda e: create_btn.config(bg=BRAND))
        tk.Button(btn_row, text="Cancel",
                  bg="#f0f2f5", fg=TEXT_SEC,
                  font=("Segoe UI", 11), relief="flat",
                  cursor="hand2", padx=20, pady=9,
                  command=dlg.destroy).pack(side="left", padx=10)

    def _open_project(self, project_name):
        self.root.after(0, lambda: switch_to(DashboardWindow, project_name))

    def _logout(self):
        if messagebox.askyesno("Logout", "Are you sure you want to logout?"):
            self.root.after(0, lambda: switch_to(LoginWindow))


