    def _bar_chart(self, canvas, data, colors):
        canvas.delete("all")
        canvas.update_idletasks()
        W = canvas.winfo_width() or 400
        if not data or all(v == 0 for _, v in data):
            canvas.create_text(W // 2, 50, text="No data yet",
                fill=TEXT_MUTED, font=("Segoe UI", 11))
            return
        max_v = max(v for _, v in data) or 1
        BAR_H, GAP, LABEL_W, PAD = 18, 16, 108, 8
        for i, ((lbl, val), clr) in enumerate(zip(data, colors)):
            y = PAD + i * (BAR_H + GAP)
            canvas.create_text(LABEL_W - 8, y + BAR_H // 2,
                text=lbl, anchor="e", fill=TEXT_SEC, font=("Segoe UI", 10))
            tx2 = W - 40
            canvas.create_rectangle(LABEL_W, y, tx2, y + BAR_H,
                fill="#f0f2f5", outline="")
            fw = int((tx2 - LABEL_W) * val / max_v)
            if fw > 0:
                canvas.create_rectangle(LABEL_W, y, LABEL_W + fw, y + BAR_H,
                    fill=clr, outline="")
            canvas.create_text(W - 22, y + BAR_H // 2,
                text=str(val), anchor="center",
                fill=TEXT_PRI, font=("Segoe UI", 10, "bold"))

    def _refresh_reports(self):
        d = self.defects

        pri_data = [
            ("Critical", sum(1 for x in d if x.get("priority","").lower()=="critical")),
            ("Major",    sum(1 for x in d if x.get("priority","").lower()=="major")),
            ("Minor",    sum(1 for x in d if x.get("priority","").lower()=="minor")),
        ]
        st_data = [
            ("Open",        sum(1 for x in d if x.get("status","").lower()=="open")),
            ("Closed",      sum(1 for x in d if x.get("status","").lower()=="closed")),
            ("In Progress", sum(1 for x in d if x.get("status","").lower()=="in progress")),
            ("Critical",    sum(1 for x in d if x.get("status","").lower()=="critical")),
            ("Resolved",    sum(1 for x in d if x.get("status","").lower()=="resolved")),
            ("Reopen",      sum(1 for x in d if x.get("status","").lower()=="reopen")),
        ]
        ac: dict = {}
        for x in d:
            a = x.get("assigned_to","").strip()
            if a and a.lower() != "name":
                ac[a] = ac.get(a, 0) + 1
        asgn_data = sorted(ac.items(), key=lambda t: t[1], reverse=True)[:8]
        pal = [BRAND, "#3b82f6", ORANGE, GREEN, PURPLE, TEAL_C, "#ec4899", "#14b8a6"]

        self.root.after(60, lambda:
            self._bar_chart(self._c_pri,  pri_data,  [BRAND, ORANGE, GREEN]))
        self.root.after(60, lambda:
            self._bar_chart(self._c_st,   st_data,
            [RED, GREEN, ORANGE, BRAND, PURPLE, TEAL_C]))
        self.root.after(60, lambda:
            self._bar_chart(self._c_asgn, asgn_data,
            pal[:len(asgn_data)]))

        total = len(d)
        done  = sum(1 for x in d
                    if x.get("status","").lower() in ("closed","resolved"))
        pct   = int(done / total * 100) if total else 0
        self._res_pct.config(text=f"{pct}%")
        self._res_meta.config(
            text=f"Total: {total}   |   Resolved / Closed: {done}")

