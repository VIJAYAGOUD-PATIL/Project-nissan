        lines = ["# LG Defect Tracker — Credentials\n"]
        for key, var in self._cred_vars.items():
            lines.append(f"{key}={var.get().strip()}\n")
        with open(".env", "w", encoding="utf-8") as f:
            f.writelines(lines)
        messagebox.showinfo("Credentials", ".env saved successfully!\nRestart the app to apply new login credentials.")

    def _save_profile(self):
        name = self._s_name.get().strip()
        if name:
            parts = name.split()
            initials = "".join(p[0].upper() for p in parts[:2]) or "VK"
            self._nav_avatar.config(text=initials)
            self._nav_name_lbl.config(text=name)
        messagebox.showinfo("Settings", "Profile saved successfully!")

    def _change_password(self):
        cur = self._sp_cur.get()
        new = self._sp_new.get()
        cnf = self._sp_cnf.get()
        if not cur:
            messagebox.showerror("Error","Enter your current password."); return
        if len(new) < 8:
            messagebox.showerror("Error","New password must be ≥ 8 characters."); return
        if new != cnf:
            messagebox.showerror("Error","Passwords do not match."); return
        messagebox.showinfo("Success","Password updated successfully!")
        self._sp_cur.set(""); self._sp_new.set(""); self._sp_cnf.set("")

