        self._main.rowconfigure(0, weight=0)   # row 0 = topbar (fixed height)
        self._main.rowconfigure(1, weight=1)   # row 1 = scroll area (expands)

    def _switch_page(self, key):
        for w in self._main.winfo_children():
            w.destroy()
        for k, btn in self._nav_btns.items():
            btn.config(bg=BRAND if k == key else SIDEBAR_BG)
        dispatch = {
            "create":  self._page_create,
            "modify":  self._page_modify,
            "view":    self._page_view,
            "results": self._page_results,
        }
        dispatch[key]()

