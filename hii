                             fg="#f87171", font=("Segoe UI", 11))
        self._err.pack(pady=(14, 0))

        root.bind("<Return>", lambda e: self._login())

    def _login(self):
        u = self._user.get().strip()
        p = self._pwd.get().strip()
        if u == USERNAME and p == PASSWORD:
            self.root.destroy()
            r = tk.Tk()
            ProjectDashboard(r)
            r.mainloop()
        else:
            self._err.config(text="✗  Invalid username or password")
            self._user.clear()
            self._pwd.clear()


